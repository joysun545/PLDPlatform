.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: var(--ui-page-bg); color: var(--ui-ink); }
.summary-card, .state-card, .notice-card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(20,45,40,.06); }
.summary-card { color: #fff; background: linear-gradient(135deg, var(--ui-gradient-start), var(--ui-gradient-end)); }
.summary-title, .summary-count, .summary-note, .notice-title, .line, .materials { display: block; }
.summary-title { font-size: 34rpx; font-weight: 700; }
.summary-count { margin-top: 12rpx; font-size: 28rpx; }
.summary-note { margin-top: 10rpx; font-size: 23rpx; opacity: .9; }
.state-card { text-align: center; color: #66706d; }
.state-card.error { color: #b83b2e; }
.secondary-button { width: 240rpx; margin-top: 24rpx; color: var(--ui-primary); background: var(--ui-primary-soft); }
.card-head, .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }
.case-no { color: #68736f; font-size: 23rpx; }
.state-pill { padding: 7rpx 14rpx; border-radius: 999rpx; color: #66716d; background: #edf1ef; font-size: 20rpx; }
.state-pill.new { color: #9b5d00; background: #fff0ca; }
.notice-title { margin-top: 18rpx; font-size: 29rpx; font-weight: 700; }
.line { margin-top: 12rpx; color: #65716d; font-size: 24rpx; }
.materials { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; color: var(--ui-primary); background: #edf9f4; font-size: 24rpx; line-height: 1.6; }
.card-foot { margin-top: 20rpx; color: #87908d; font-size: 22rpx; }
.detail-action { color: var(--ui-primary); font-weight: 600; }
.secondary-button::after { border: 0; }
