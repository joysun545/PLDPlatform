.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  color: #202624;
  background: #f5f7f8;
}

.state-card,
.task-context-card,
.hero-card,
.rule-card,
.empty-card,
.list-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(20, 45, 40, 0.06);
}

.state-card,
.empty-card { color: #68726f; text-align: center; }
.state-card.error { color: #b33a2d; }
.secondary-button { width: 240rpx; margin-top: 22rpx; color: #087f5b; background: #eaf8f2; }
.secondary-button::after { border: 0; }

.task-context-head,
.task-context-row-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.task-context-title { font-size: 29rpx; font-weight: 700; }
.task-context-count { color: #087f5b; font-size: 22rpx; }
.task-context-row { margin-top: 18rpx; padding: 20rpx; border-left: 6rpx solid #7bcaa9; border-radius: 13rpx; background: #f8fcfa; }
.task-context-row.unread { border-left-color: #e5a400; background: #fffaf0; }
.task-context-row-title { flex: 1; font-size: 25rpx; font-weight: 650; }
.task-context-state { flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; }
.task-context-state.unread { color: #a35d00; background: #fff0d7; }
.task-context-state.read { color: #39725e; background: #e8f7f0; }
.task-context-summary,
.task-context-hint { display: block; margin-top: 9rpx; color: #68736f; font-size: 22rpx; line-height: 1.5; }
.task-context-hint { color: #087f5b; }

.hero-card { color: #fff; background: linear-gradient(135deg, #08b878, #087f69); }
.hero-title,
.hero-name,
.hero-meta,
.rule-title,
.rule-text,
.primary-name,
.secondary-name,
.material-summary,
.note { display: block; }
.hero-title { font-size: 35rpx; font-weight: 700; }
.hero-name { margin-top: 20rpx; font-size: 29rpx; font-weight: 600; }
.hero-meta { margin-top: 9rpx; font-size: 23rpx; opacity: 0.9; }

.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 24rpx; }
.summary-card { padding: 28rpx 18rpx; border-radius: 20rpx; text-align: center; color: #087f5b; background: #eaf9f3; }
.summary-card.purple { color: #6d28d9; background: #f3edff; }
.summary-card.blue { color: #1769aa; background: #eaf5ff; }
.summary-number,
.summary-label { display: block; }
.summary-number { font-size: 48rpx; font-weight: 700; }
.summary-label { margin-top: 8rpx; font-size: 23rpx; }

.rule-card { border-left: 8rpx solid #0a9f6b; background: #f0fbf6; }
.rule-title { font-size: 27rpx; font-weight: 700; }
.rule-text { margin-top: 12rpx; color: #5c6c66; font-size: 23rpx; line-height: 1.7; }

.tabs { display: flex; margin-bottom: 24rpx; padding: 7rpx; border-radius: 18rpx; background: #e8eceb; }
.tab { flex: 1; padding: 20rpx 8rpx; border-radius: 14rpx; color: #68716e; text-align: center; font-size: 25rpx; }
.tab.active { color: #087f5b; font-weight: 700; background: #fff; box-shadow: 0 5rpx 14rpx rgba(20, 45, 40, 0.08); }

.list-card { border: 2rpx solid transparent; }
.list-card.material { border-left: 7rpx solid #7c3aed; }
.list-card.focused { border-color: #f2a900; box-shadow: 0 0 0 6rpx rgba(242, 169, 0, 0.13); }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.primary-name { font-size: 29rpx; font-weight: 700; }
.secondary-name { margin-top: 9rpx; color: #69726f; font-size: 24rpx; }
.warranty-tag { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; color: #087f5b; background: #e8f8f1; font-size: 20rpx; }
.repair-tag { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; color: #1769aa; background: #eaf5ff; font-size: 20rpx; }
.line { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0ef; color: #5f6966; font-size: 23rpx; }
.line text:last-child { max-width: 68%; color: #2c3532; text-align: right; word-break: break-all; }
.material-summary,
.note { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; color: #58645f; background: #f2f7f5; font-size: 23rpx; line-height: 1.55; }
.note { color: #5d4a6e; background: #f5f1fa; }
