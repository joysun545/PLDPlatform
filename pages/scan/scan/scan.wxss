/* pages/scan/scan/scan.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(#f0f2f5, #ffffff);
}

.header {
  background: linear-gradient(135deg, #07c160, #009688);
  color: white;
  text-align: center;
  padding: 30rpx 0 60rpx;
  border-bottom-left-radius: 50rpx;
  border-bottom-right-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
}

.role {
  font-size: 36rpx;
  margin: 20rpx 0;
  display: block;
  opacity: 0.9;
}

.welcome {
  font-size: 32rpx;
  opacity: 0.8;
}

.tip {
  font-size: 36rpx;
  color: #333;
  margin-bottom: 80rpx;
}

.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 150rpx;
  padding-bottom: 120rpx;
}

.big-scan-btn {
  width: 300rpx;
  height: 300rpx;
  background: white;
  border-radius: 50rpx;
  box-shadow: 0 15rpx 40rpx rgba(7, 193, 96, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
} 

.big-scan-btn[disabled] {
  opacity: 0.72;
}

.big-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
}

.btn-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #07c160;
} 

.scan-tip {
  margin-top: 44rpx;
  color: #7a7f86;
  font-size: 28rpx;
}



