<theme-shell>
<!-- pages/scan/scan/scan.wxml -->
<view class="container">
  <view class="scan-area">
    <button
      class="big-scan-btn"
      bindtap="directScan"
      loading="{{scanning}}"
      disabled="{{scanning}}"
    >
      <image src="/images/theme_icons/{{iconTheme}}/scan-qrcode.png" class="big-icon" mode="aspectFit" />
      <text class="btn-text">{{scanning ? '正在识别' : '扫描二维码'}}</text>
    </button>
    <text class="scan-tip">
      {{role === 'tourist' ? '游客可查看设备公开信息' : '扫描设备二维码查看当前状态'}}
    </text>
  </view>
</view>

</theme-shell>
