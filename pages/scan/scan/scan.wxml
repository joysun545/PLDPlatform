<theme-shell>
<!-- pages/scan/scan/scan.wxml -->
<view class="container">
  <view class="scan-area">
    <button
      class="big-scan-btn"
      bindtap="directScan"
      loading="{{scanning}}"
      disabled="{{scanning}}"
    >
      <image src="/images/theme_icons/{{iconTheme}}/scan-qrcode.png" class="big-icon" mode="aspectFit" />
      <text class="btn-text">{{scanning ? '正在识别' : '扫描二维码'}}</text>
    </button>
    <text class="scan-tip">
      {{role === 'tourist' ? '游客可查看设备公开信息' : '扫描设备二维码查看当前状态'}}
    </text>
    <navigator wx:if="{{role === 'tourist'}}" url="/pages/theme/setting/setting" class="scan-tip">界面主题 ›</navigator>
    <view wx:if="{{role === 'tourist' && !isPlatformAdmin}}" class="root-trial-entry">
      <button class="root-trial-button" bindtap="openRootTrialApplication" disabled="{{scanning}}">申请成为根组织厂家负责人</button>
      <text class="root-trial-tip">提交企业资料，经项目超级管理员审核后开通试用。</text>
    </view>
  </view>
</view>

</theme-shell>
