.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
  color: #20252b;
  background: #f3f6f8;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  padding: 60rpx 32rpx;
  color: #66707a;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx;
}

.state-box.error {
  color: #b93636;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
}

.state-message {
  margin-top: 18rpx;
  font-size: 27rpx;
}

.loading-dot {
  width: 22rpx;
  height: 22rpx;
  margin-bottom: 24rpx;
  background: #07c160;
  border-radius: 50%;
  box-shadow: 34rpx 0 #76dba7, -34rpx 0 #bcefd4;
}

.hero-card {
  padding: 38rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #09bb68, #008d78);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(0, 153, 112, 0.2);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.mode-badge,
.status-badge {
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 22rpx;
}

.status-badge {
  background: rgba(255, 255, 255, 0.28);
}

.model-name,
.model-code,
.identity-line {
  display: block;
}

.model-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.model-code {
  margin-top: 10rpx;
  font-size: 27rpx;
  opacity: 0.84;
}

.identity-line {
  margin-top: 24rpx;
  padding-top: 20rpx;
  font-size: 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}

.info-card,
.action-card {
  margin-top: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(32, 52, 69, 0.045);
}

.card-title {
  margin-bottom: 16rpx;
  color: #20252b;
  font-size: 31rpx;
  font-weight: 700;
}

.sub-title {
  margin: 28rpx 0 18rpx;
  color: #59636d;
  font-size: 26rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  padding: 19rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.info-row:last-child {
  border-bottom: 0;
}

.label {
  flex-shrink: 0;
  color: #89919a;
  font-size: 26rpx;
}

.value {
  color: #30363d;
  font-size: 26rpx;
  text-align: right;
  word-break: break-all;
}

.value.accent {
  color: #079e52;
  font-weight: 600;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.status-cell {
  padding: 22rpx;
  background: #f5faf7;
  border-radius: 16rpx;
}

.status-label,
.status-value {
  display: block;
}

.status-label {
  color: #859089;
  font-size: 23rpx;
}

.status-value {
  margin-top: 8rpx;
  color: #087e48;
  font-size: 28rpx;
  font-weight: 600;
}

.relation-highlight {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 22rpx;
  background: #eaf8f0;
  border-radius: 16rpx;
}

.relation-caption {
  color: #678074;
  font-size: 24rpx;
}

.relation-value {
  color: #078d4b;
  font-size: 27rpx;
  font-weight: 700;
}

.path-item {
  display: flex;
  min-height: 88rpx;
}

.path-axis {
  position: relative;
  width: 42rpx;
  flex-shrink: 0;
}

.path-dot {
  position: relative;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  margin: 8rpx 0 0 5rpx;
  background: #07c160;
  border: 6rpx solid #dff6e9;
  border-radius: 50%;
}

.path-line {
  position: absolute;
  top: 28rpx;
  bottom: -8rpx;
  left: 16rpx;
  width: 2rpx;
  background: #cdebdc;
}

.path-content {
  padding: 0 0 22rpx 8rpx;
}

.path-name,
.path-meta {
  display: block;
}

.path-name {
  font-size: 27rpx;
  font-weight: 600;
}

.path-meta {
  margin-top: 7rpx;
  color: #8a9299;
  font-size: 23rpx;
}

.account-owner {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #3e454c;
  font-size: 25rpx;
}

.account-role {
  color: #818990;
}

.pending-banner,
.activated-banner {
  margin-bottom: 18rpx;
  padding: 20rpx;
  color: #8a5d07;
  font-size: 25rpx;
  line-height: 1.55;
  background: #fff6dd;
  border-radius: 14rpx;
}

.activated-banner {
  color: #087a46;
  background: #eaf8f0;
}

.trace-card {
  overflow: hidden;
}

.trace-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trace-title {
  margin-bottom: 6rpx;
}

.trace-summary,
.expand-icon {
  color: #7c858e;
  font-size: 24rpx;
}

.expand-icon {
  color: #079e52;
}

.bom-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #edf0f2;
}

.bom-item:first-of-type {
  margin-top: 22rpx;
}

.bom-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.material-name {
  font-weight: 600;
}

.material-code,
.bom-line {
  color: #7d858d;
  font-size: 24rpx;
}

.bom-line {
  display: block;
  margin-top: 8rpx;
}

.public-tip {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  color: #64716b;
  font-size: 25rpx;
  line-height: 1.65;
  background: #eaf7ef;
  border-radius: 18rpx;
}

.primary-btn,
.secondary-btn,
.scan-again-btn,
.modal-done-btn {
  border-radius: 16rpx;
}

.primary-btn {
  color: #ffffff;
  background: #07c160;
}

.install-btn {
  background: linear-gradient(135deg, #07c160, #05a960);
}

.invite-btn {
  background: linear-gradient(135deg, #078ed4, #0877b8);
}

.secondary-btn {
  width: 320rpx;
  margin-top: 30rpx;
  color: #ffffff;
  background: #07c160;
}

.scan-again-btn {
  margin-top: 26rpx;
  color: #4f5a64;
  background: #ffffff;
}

.modal-root,
.modal-mask {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.modal-mask {
  background: rgba(17, 25, 31, 0.58);
}

.invite-modal {
  position: fixed;
  z-index: 91;
  right: 36rpx;
  bottom: 54rpx;
  left: 36rpx;
  padding: 34rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-close {
  padding: 4rpx 12rpx;
  color: #818991;
  font-size: 46rpx;
  line-height: 1;
}

.modal-device {
  display: block;
  margin-top: 12rpx;
  color: #737d85;
  font-size: 24rpx;
}

.qr-wrap,
.expired-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 430rpx;
  height: 430rpx;
  margin: 28rpx auto 16rpx;
  background: #f7faf8;
  border-radius: 20rpx;
}

.invite-qr {
  width: 390rpx;
  height: 390rpx;
}

.expired-box {
  color: #a33b3b;
  font-size: 29rpx;
}

.countdown {
  display: block;
  color: #078d4b;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
}

.modal-tip {
  display: block;
  margin: 22rpx 4rpx;
  color: #6f7880;
  font-size: 24rpx;
  line-height: 1.65;
}

.modal-done-btn {
  margin-top: 18rpx;
  color: #56616a;
  background: #f0f3f4;
}

button::after {
  border: 0;
}

