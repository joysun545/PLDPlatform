<view class="page">
  <view class="state-box" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text>正在读取设备信息...</text>
  </view>

  <view class="state-box error" wx:elif="{{error}}">
    <text class="state-title">无法读取设备</text>
    <text class="state-message">{{error}}</text>
    <button class="secondary-btn" bindtap="scanAgain">返回重新扫码</button>
  </view>

  <block wx:elif="{{device}}">
    <view class="hero-card">
      <view class="hero-top">
        <text class="mode-badge">{{viewModeName}}</text>
        <text class="status-badge">{{device.status_summary.status_name}}</text>
      </view>
      <text class="model-name">{{device.product_model.name}}</text>
      <text class="model-code">{{device.product_model.code}}</text>
      <view class="identity-line" wx:if="{{viewerRelationSummary}}">
        <text>{{viewerRelationSummary}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="card-title">设备基础信息</view>
      <view class="info-row">
        <text class="label">设备序列号</text>
        <text class="value mono">{{device.sn}}</text>
      </view>
      <view class="info-row">
        <text class="label">产品品类</text>
        <text class="value">{{device.product_model.category}}</text>
      </view>
      <view class="info-row">
        <text class="label">生产厂家</text>
        <text class="value">{{device.manufacturer}}</text>
      </view>
      <view class="info-row" wx:if="{{device.product_model.brand}}">
        <text class="label">品牌</text>
        <text class="value">{{device.product_model.brand}}</text>
      </view>
      <view class="status-grid">
        <view class="status-cell">
          <text class="status-label">安装</text>
          <text class="status-value">{{device.status_summary.install_status_name}}</text>
        </view>
        <view class="status-cell">
          <text class="status-label">激活</text>
          <text class="status-value">{{device.status_summary.activation_status_name}}</text>
        </view>
      </view>
    </view>

    <view class="info-card" wx:if="{{showRegion}}">
      <view class="card-title">区域服务信息</view>
      <view class="info-row">
        <text class="label">所属区域</text>
        <text class="value">{{region.name || '暂未划分区域'}}</text>
      </view>
      <view class="info-row" wx:if="{{region.owner}}">
        <text class="label">区域属主</text>
        <text class="value">{{region.owner.name}}</text>
      </view>
      <view class="info-row" wx:else>
        <text class="label">区域属主</text>
        <text class="value">暂未建立区域属主</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{showOwnership}}">
      <view class="card-title">设备属主关系</view>
      <view class="relation-highlight">
        <text class="relation-caption">我与这台设备</text>
        <text class="relation-value">{{viewerRelationSummary}}</text>
      </view>
      <view class="info-row">
        <text class="label">当前直接属主</text>
        <text class="value">{{ownership.direct_owner.name || '-'}}</text>
      </view>
      <view class="info-row" wx:if="{{ownership.regional_owner}}">
        <text class="label">区域属主</text>
        <text class="value">{{ownership.regional_owner.name}}</text>
      </view>

      <view class="sub-title" wx:if="{{ownershipPath.length}}">组织流转链路</view>
      <view class="path-list">
        <view class="path-item" wx:for="{{ownershipPath}}" wx:key="id">
          <view class="path-axis">
            <view class="path-dot"></view>
            <view class="path-line" wx:if="{{!item.isLast}}"></view>
          </view>
          <view class="path-content">
            <text class="path-name">{{item.name}}</text>
            <text class="path-meta">{{item.type_name}} · {{item.region || '未填写区域'}}</text>
          </view>
        </view>
      </view>

      <block wx:if="{{upstreamAccountOwners.length}}">
        <view class="sub-title">链路建立账号</view>
        <view class="account-owner" wx:for="{{upstreamAccountOwners}}" wx:key="identity_id">
          <text>{{item.nickname}}</text>
          <text class="account-role">{{item.role_name}}</text>
        </view>
      </block>
    </view>

    <view class="info-card" wx:if="{{showDeviceDetail}}">
      <view class="card-title">设备当前状态</view>
      <view class="pending-banner" wx:if="{{isPendingActivation}}">
        设备已经完成装车，正在等待用户负责人激活
      </view>
      <view class="activated-banner" wx:if="{{isActivated}}">
        设备已经由用户完成激活
      </view>
      <view class="info-row">
        <text class="label">生产批次</text>
        <text class="value mono">{{device.batch.batch_no}}</text>
      </view>
      <view class="info-row">
        <text class="label">生产日期</text>
        <text class="value">{{device.batch.production_date}}</text>
      </view>
      <view class="info-row">
        <text class="label">设备状态</text>
        <text class="value accent">{{device.state.status_name}}</text>
      </view>
      <view class="info-row" wx:if="{{device.current_organization}}">
        <text class="label">当前所属组织</text>
        <text class="value">{{device.current_organization.name}}</text>
      </view>
      <view class="info-row" wx:if="{{device.installation.installed_at_text}}">
        <text class="label">装车时间</text>
        <text class="value">{{device.installation.installed_at_text}}</text>
      </view>
      <view class="info-row" wx:if="{{device.installation.operator_name}}">
        <text class="label">装车操作账号</text>
        <text class="value">{{device.installation.operator_name}}</text>
      </view>
    </view>

    <view class="info-card trace-card" wx:if="{{showTraceability}}">
      <view class="trace-header" bindtap="toggleTraceability">
        <view>
          <view class="card-title trace-title">批次BOM追溯</view>
          <text class="trace-summary">{{traceability.bom.version}} · {{traceability.items.length}} 项物料</text>
        </view>
        <text class="expand-icon">{{traceExpanded ? '收起' : '展开'}}</text>
      </view>

      <block wx:if="{{traceExpanded}}">
        <view class="bom-item" wx:for="{{traceability.items}}" wx:key="material_code">
          <view class="bom-heading">
            <text class="material-name">{{item.material_name}}</text>
            <text class="material-code">{{item.material_code}}</text>
          </view>
          <text class="bom-line">规格：{{item.spec_name || '未指定'}}</text>
          <text class="bom-line">供应商：{{item.supplier_name || '未指定'}}</text>
          <text class="bom-line" wx:if="{{item.remark}}">备注：{{item.remark}}</text>
        </view>
      </block>
    </view>

    <view class="public-tip" wx:if="{{viewMode === 'public'}}">
      当前为公开设备信息。系统内业务账号可根据与设备的关系查看对应内容。
    </view>

    <view class="public-tip" wx:if="{{viewMode === 'registered'}}">
      您是系统内账号，但与这台设备没有属主链路关系，当前仅显示区域服务信息。
    </view>

    <view class="action-card" wx:if="{{canInstall || canCreateCustomerInvitation}}">
      <button
        class="primary-btn install-btn"
        loading="{{actionLoading}}"
        disabled="{{actionLoading}}"
        bindtap="confirmInstall"
        wx:if="{{canInstall}}"
      >确认装车</button>

      <button
        class="primary-btn invite-btn"
        loading="{{actionLoading}}"
        disabled="{{actionLoading}}"
        bindtap="refreshCustomerInvitation"
        wx:if="{{canCreateCustomerInvitation}}"
      >生成用户负责人邀请二维码</button>
    </view>

    <button class="scan-again-btn" bindtap="scanAgain">返回重新扫码</button>
  </block>

  <view class="modal-root" wx:if="{{showInvitationModal}}">
    <view class="modal-mask" bindtap="closeInvitationModal"></view>
    <view class="invite-modal" catchtap="stopTap">
      <view class="modal-head">
        <text class="modal-title">邀请用户负责人</text>
        <text class="modal-close" bindtap="closeInvitationModal">×</text>
      </view>
      <text class="modal-device">{{device.product_model.name}} · {{device.sn}}</text>

      <view class="qr-wrap" wx:if="{{!invitationExpired}}">
        <image
          class="invite-qr"
          src="{{invitation.qr_image_url}}"
          mode="aspectFit"
          show-menu-by-longpress="{{true}}"
        />
      </view>
      <view class="expired-box" wx:else>
        <text>邀请二维码已过期</text>
      </view>

      <text class="countdown" wx:if="{{!invitationExpired}}">
        剩余有效时间 {{invitationCountdown}}
      </text>
      <text class="modal-tip">
        请让用户负责人使用小程序扫一扫。该二维码只能用于这台设备，并且只能使用一次。
      </text>

      <button
        class="primary-btn"
        bindtap="refreshCustomerInvitation"
        loading="{{actionLoading}}"
        disabled="{{actionLoading}}"
        wx:if="{{invitationExpired}}"
      >重新生成二维码</button>
      <button class="modal-done-btn" bindtap="closeInvitationModal">暂时关闭</button>
    </view>
  </view>
</view>
