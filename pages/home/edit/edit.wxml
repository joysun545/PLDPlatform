<theme-shell title-eyebrow="邀请链路" title-subtitle="{{manager && manager.is_owner_role ? '显示本组织有效岗位成员及当前账号建立的跨组织直接链路' : '显示由当前账号建立的有效直接角色关系和跨组织业务链路'}}">
<view class="page">
  <view class="manager-bar" wx:if="{{manager}}">
    <view>
      <text class="manager-label">当前组织</text>
      <text class="manager-name">{{manager.organization_name}}</text>
    </view>
    <text class="manager-role">{{manager.role_name}}</text>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <text>正在加载直接下级账号…</text>
  </view>

  <view class="state-card error" wx:elif="{{loadError}}">
    <text>{{loadError}}</text>
    <button class="secondary-button small" bindtap="retryLoad">重新加载</button>
  </view>

  <view class="state-card" wx:elif="{{subordinates.length === 0}}">
    <text class="empty-title">暂无已加入的直接下级账号</text>
    <text class="empty-tip">通过“邀请下级”发出邀请，对方接受并建立有效身份后会显示在这里。</text>
    <button class="primary-button invite-button" bindtap="goInvite">邀请下级</button>
  </view>

  <block wx:else>
    <view class="summary-row">
      <text>有效直接下级</text>
      <text>{{subordinates.length}} 个</text>
    </view>

    <view class="channel-warning" wx:if="{{channelError}}">
      <text>{{channelError}}</text>
      <text>下级身份仍可查看，下拉刷新后可重试渠道资料。</text>
    </view>

    <view class="subordinate-card" wx:for="{{subordinates}}" wx:for-item="item" wx:key="item_key">
      <view class="account-row" id="merchant-catalog-focus-{{item.organization.id}}">
        <view class="avatar-wrap">
          <image
            class="avatar"
            wx:if="{{item.user.avatar_url}}"
            src="{{item.user.avatar_url}}"
            mode="aspectFill"
          />
          <text class="avatar-fallback" wx:else>人</text>
        </view>
        <view class="account-main">
          <text class="account-name">{{item.user.nickname}}</text>
          <text class="account-role">{{item.role.name}}</text>
        </view>
        <text
          class="status configured"
          wx:if="{{item.management_mode !== 'merchant_channel'}}"
        >关系有效</text>
        <text
          class="status {{item.channel && item.channel.configured ? 'configured' : 'pending'}}"
          wx:else
        >{{item.channel && item.channel.configured ? '已配置' : '待配置'}}</text>
      </view>

      <view class="info-list">
        <view class="info-row">
          <text class="info-label">所属组织</text>
          <text class="info-value">{{item.organization.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">组织类型</text>
          <text class="info-value">{{item.organization.type_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">邀请关系</text>
          <text class="info-value">{{item.scope_name}} · {{item.relation_type_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系电话</text>
          <text class="info-value">{{item.user.phone || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">所在区域</text>
          <text class="info-value">{{item.channel ? (item.channel.region || '未配置') : (item.organization.region || '未填写')}}</text>
        </view>
        <view class="info-row" wx:if="{{item.management_mode === 'merchant_channel'}}">
          <text class="info-label">渠道品牌</text>
          <text class="info-value">{{item.catalog_brand_label || '未配置'}}</text>
        </view>
        <view class="info-row" wx:if="{{item.role.code === 'merchant_owner' && item.organization.type_code === 'MERCHANT'}}">
          <text class="info-label">经营范围</text>
          <text class="info-value">{{item.has_operating_categories ? item.operating_category_count + ' 个有效品类' : '尚未配置有效品类'}}</text>
        </view>
      </view>

      <button
        class="edit-button"
        wx:if="{{item.management_mode === 'merchant_channel' && editingInvitationId != item.invitation_id}}"
        data-invitation-id="{{item.invitation_id}}"
        bindtap="startEdit"
      >{{item.channel && item.channel.configured ? '编辑经营区域' : '配置经营区域'}}</button>

      <view
        class="edit-panel"
        wx:if="{{item.management_mode === 'merchant_channel' && editingInvitationId == item.invitation_id}}"
      >
        <text class="edit-title">编辑经营区域</text>

        <text class="field-label">负责区域</text>
        <input
          class="input-field"
          value="{{regionDraft}}"
          maxlength="255"
          placeholder="例如：四川省或成渝区域"
          bindinput="onRegionInput"
        />

        <view class="button-row">
          <button class="secondary-button" disabled="{{saving}}" bindtap="cancelEdit">取消</button>
          <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveMerchantChannel">保存</button>
        </view>
      </view>

      <button
        class="edit-button catalog-open-button"
        wx:if="{{item.management_mode === 'merchant_channel' || item.management_mode === 'merchant_catalog'}}"
        data-organization-id="{{item.organization.id}}"
        bindtap="openCatalogEditor"
      >编辑品牌、品类和产品型号</button>

      <view
        class="catalog-editor edit-panel"
        wx:if="{{catalogEditor && catalogEditor.organizationId == item.organization.id}}"
      >
        <view class="catalog-editor-heading">
          <view>
            <text class="edit-title">{{catalogEditor.organizationName}} · 经营范围</text>
            <text class="catalog-hint">{{item.management_mode === 'merchant_channel' ? '从厂家产品目录选择；范围只作用于当前厂家根链路。' : '只能选择上级商家已授权的品牌、品类和型号。'}}</text>
          </view>
          <button class="close-button" disabled="{{catalogSaving}}" bindtap="closeCatalogEditor">关闭</button>
        </view>

        <view class="catalog-loading" wx:if="{{catalogLoading}}">正在读取可授权范围…</view>
        <block wx:elif="{{catalogEditor.brands.length === 0}}">
          <view class="catalog-empty">上级当前没有可授权的品牌、品类和产品型号。</view>
        </block>
        <block wx:else>
          <text class="field-label">已确认的品牌范围（仍可移除后重新选择）</text>
          <view class="draft-scope" wx:if="{{catalogEditor.draft.length}}">
            <view class="draft-brand" wx:for="{{catalogEditor.draft}}" wx:for-item="scope" wx:key="brand_id">
              <view class="draft-brand-main">
                <text class="draft-brand-name">{{scope.brand_name}}</text>
                <text class="draft-brand-detail" wx:for="{{scope.categories}}" wx:for-item="category" wx:key="category_id">
                  {{category.category_name}}（{{category.product_model_ids.length}} 个型号）<text wx:if="{{index + 1 < scope.categories.length}}">、</text>
                </text>
              </view>
              <button class="remove-scope-button" data-brand-id="{{scope.brand_id}}" disabled="{{catalogSaving}}" bindtap="removeDraftCatalogBrand">移除</button>
            </view>
          </view>
          <view class="catalog-empty" wx:else>还没有加入品牌范围。请从下方逐个选择并确认。</view>

          <view class="catalog-step">
            <text class="step-title">第一步：选择品牌（可再次选择同一品牌）</text>
            <picker
              range="{{catalogEditor.availableBrands}}"
              range-key="name"
              value="{{catalogEditor.brandIndex}}"
              bindchange="onCatalogBrandChange"
              disabled="{{catalogEditor.availableBrands.length === 0}}"
            >
              <view class="picker-field {{catalogEditor.brandIndex < 0 ? 'placeholder' : ''}}">
                {{catalogEditor.brandIndex >= 0 ? catalogEditor.availableBrands[catalogEditor.brandIndex].name : (catalogEditor.availableBrands.length ? '选择品牌' : '暂无可选品牌')}}
                <text class="picker-arrow">⌄</text>
              </view>
            </picker>
          </view>

          <view class="catalog-step" wx:if="{{catalogEditor.brandIndex >= 0}}">
            <text class="step-title">第二步：选择经营品类</text>
            <text class="step-hint">选择多个品类时，默认包含每个所选品类的全部型号；只选一个品类时，可再调整型号。</text>
            <view class="inline-actions">
              <text bindtap="selectAllCatalogCategories">全选品类</text>
              <text bindtap="clearCatalogCategories">清空选择</text>
            </view>
            <checkbox-group class="choice-list" bindchange="onCatalogCategoryChange">
              <label class="choice-row" wx:for="{{catalogEditor.currentCategories}}" wx:for-item="category" wx:key="id">
                <checkbox value="{{category.id}}" checked="{{category.checked}}" />
                <view class="choice-copy">
                  <text class="choice-name">{{category.name}}</text>
                  <text class="choice-meta">{{category.models.length}} 个可选型号</text>
                </view>
              </label>
            </checkbox-group>
          </view>

          <view class="catalog-step" wx:if="{{catalogEditor.selectedCategoryIds.length === 1}}">
            <view class="model-heading">
              <view>
                <text class="step-title">第三步：选择该品类的产品型号</text>
                <text class="step-hint">默认全选；可全选、多选或反选。</text>
              </view>
              <view class="model-actions">
                <text bindtap="selectAllCatalogModels">全选</text>
                <text bindtap="invertCatalogModels">反选</text>
              </view>
            </view>
            <checkbox-group class="choice-list model-list" bindchange="onCatalogModelChange">
              <label class="choice-row" wx:for="{{catalogEditor.currentModels}}" wx:for-item="model" wx:key="id">
                <checkbox value="{{model.id}}" checked="{{model.checked}}" />
                <view class="choice-copy">
                  <text class="choice-name">{{model.name}}</text>
                  <text class="choice-meta">{{model.code}}</text>
                </view>
              </label>
            </checkbox-group>
            <text class="catalog-empty" wx:if="{{catalogEditor.currentModels.length === 0}}">该品类目前没有可授权型号。</text>
          </view>

          <button
            class="primary-button confirm-brand-button"
            wx:if="{{catalogEditor.brandIndex >= 0 && catalogEditor.selectedCategoryIds.length > 0}}"
            disabled="{{catalogSaving}}"
            bindtap="confirmCatalogBrand"
          >确认当前品牌范围并继续</button>

          <view class="button-row final-catalog-actions">
            <button class="secondary-button" disabled="{{catalogSaving}}" bindtap="closeCatalogEditor">取消</button>
            <button class="primary-button" loading="{{catalogSaving}}" disabled="{{catalogSaving}}" bindtap="saveAllCatalogScopes">最终确认并保存</button>
          </view>
        </block>
      </view>

      <view
        class="qualification-panel"
        wx:if="{{(item.management_mode === 'merchant_channel' || item.management_mode === 'merchant_catalog') && item.role.code === 'merchant_owner' && item.organization.type_code === 'MERCHANT'}}"
      >
        <view class="qualification-copy">
          <text class="qualification-title">售后服务资格</text>
          <text class="qualification-tip" wx:if="{{item.has_operating_categories}}">资格范围按有效经营品类确定，不会缩小到型号。</text>
          <text class="qualification-tip" wx:else>先保存至少一个有效经营品类，再开启售后服务资格。</text>
        </view>
        <checkbox-group
          class="qualification-control"
          data-organization-id="{{item.organization.id}}"
          bindchange="onAfterSalesQualificationChange"
        >
          <label class="qualification-option">
            <checkbox
              value="enabled"
              checked="{{item.organization.provides_after_sales}}"
              disabled="{{(!item.has_operating_categories && !item.organization.provides_after_sales) || savingAfterSalesOrganizationId}}"
            />
            <text>提供售后服务</text>
          </label>
        </checkbox-group>
      </view>

      <view class="protected-tip" wx:if="{{item.management_mode === 'view_only'}}">
        <text>账号岗位、组织归属与邀请关系由身份链路维护。</text>
      </view>
    </view>
  </block>

  <view class="safe-tip" wx:if="{{!loading && !loadError}}">
    <text>本页面不会修改账号角色、所属组织或上下级邀请链路。厂家销售经理维护直属商家的经营区域；渠道品牌依据已保存的品牌、品类和型号经营范围显示。商家负责人只能向下授权自己有效范围内的子集。</text>
  </view>
</view>
</theme-shell>
