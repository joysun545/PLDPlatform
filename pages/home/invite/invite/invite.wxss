/* pages/common/invite/invite/invite.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(#f0f2f5, #ffffff);
}

.header {
  background: linear-gradient(135deg, #07c160, #009688);
  color: white;
  text-align: center;
  padding: 80rpx 0 60rpx;
  border-bottom-left-radius: 50rpx;
  border-bottom-right-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
}

.role {
  font-size: 36rpx;
  margin: 20rpx 0;
  display: block;
  opacity: 0.9;
}

.welcome {
  font-size: 32rpx;
  opacity: 0.8;
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;  
  gap: 10rpx;
  padding: 60rpx 40rpx;
}

.menu-item {
  width: 100%; 
  background: white;
  border-radius: 30rpx;
  padding: 50rpx 20rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  border: none;
}

.menu-item::after {
  border: none;
}

.menu-item:active {
  transform: scale(0.95);
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.15);
}

.menu-grid .menu-item:only-child {
  grid-column: 1 / -1;   
  justify-self: center; 
}

.icon {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 30rpx;
}

.menu-item text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}


.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.7);
}

.modal-content {
  background: white;
  padding: 60rpx;
  border-radius: 30rpx;
  text-align: center;
  position: relative;
  width: 80%;
  max-width: 700rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.3);
}

.modal-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  display: block;
}

.qrcode-img {
  width: 500rpx;
  height: 500rpx;
  margin: 0 auto 40rpx;
}

.modal-tip {
  font-size: 32rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.modal-tip.small {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.close-btn {
  background: #07c160;
  color: white;
  font-size: 36rpx;
  padding: 25rpx 100rpx;
  border-radius: 60rpx;
  margin-top: 60rpx;
}



