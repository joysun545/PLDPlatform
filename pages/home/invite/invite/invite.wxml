<view class="container">
  <view class="header">
    <text class="title">邀请组织成员</text>
    <text class="role">{{role_name}}</text>
    <text class="welcome">欢迎，{{nickname || '用户'}}</text>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">
    正在获取可邀请岗位...
  </view>

  <view class="empty-tip" wx:elif="{{availableRoles.length === 0}}">
    当前岗位没有可发起的邀请
  </view>

  <view class="menu-grid" wx:else>
    <block wx:for="{{availableRoles}}" wx:key="rule_id">
      <button
        class="menu-item"
        bindtap="selectRole"
        disabled="{{creating}}"
        data-ruleid="{{item.rule_id}}"
        data-role="{{item.role}}"
        data-name="{{item.name}}"
      >
        <image src="/images/role_manage.png" class="icon" />
        <text>{{item.name}}</text>
        <text class="scope-tip" wx:if="{{item.scope === 'cross_organization'}}">
          建立{{item.organization_type_name}}组织
        </text>
        <text class="scope-tip" wx:else>加入当前组织</text>
      </button>
    </block>
  </view>

  <view class="share-panel" wx:if="{{shareReady}}">
    <text class="selected-role">已指定岗位：{{selectedRoleName}}</text>
    <text class="share-tip">受邀者不能修改岗位，请点击下面按钮分享。</text>
    <button class="share-btn" open-type="share">分享邀请链接</button>
  </view>
</view>
