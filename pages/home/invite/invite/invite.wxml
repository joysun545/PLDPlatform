<!-- pages/home/invite/invite/invite.wxml -->
<view class="container">
  <view class="header">
    <text class="title">邀请下级用户</text>
    <text class="role">{{role_name}}</text>
    <text class="welcome">欢迎，{{nickname || '用户'}}</text>
  </view>

  <view class="menu-grid">
    <block wx:for="{{availableRoles}}" wx:key="role">
      <button 
        class="menu-item" 
        bindtap="selectRole" 
        data-role="{{item.role}}" 
        data-name="{{item.name}}"
      >
        <image src="/images/role_manage.png" class="icon" />
        <text>{{item.name}}</text>
      </button>
    </block>

