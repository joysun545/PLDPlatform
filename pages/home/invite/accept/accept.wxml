<view class="container">
  <view class="loading-tip" wx:if="{{loading}}">
    正在读取邀请信息...
  </view>

  <block wx:if="{{invitationReady}}">
    <view class="header">
      <view class="user-info-row">
        <view class="avatar">
          <image src="{{inviterAvatar}}" mode="aspectFill" />
        </view>
        <view class="info-right">
          <text class="name">{{inviterNickname || '邀请人'}}</text>
          <text class="role">{{inviterRoleName}}</text>
          <text class="organization">{{sourceOrganizationName}}</text>
        </view>
      </view>
    </view>

    <view class="invite-info">
      <text class="text">邀请您成为：</text>
      <text class="highlight-role">{{targetRoleName}}</text>
      <text class="desc">接受后将为您开放该岗位的功能入口</text>
    </view>

    <view class="profile-form">
      <view class="form-title">完善账号资料</view>

      <view class="form-item">
        <text class="label">昵称</text>
        <input
          type="nickname"
          placeholder="点击选择微信昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          class="input"
        />
      </view>

      <view class="form-item">
        <text class="label">头像</text>
        <button
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          class="avatar-btn"
        >
          <image
            src="{{avatarUrl || '/images/default_avatar.png'}}"
            class="avatar-preview"
            mode="aspectFill"
          />
          <text class="avatar-tip">点击选择头像</text>
        </button>
      </view>

      <view class="form-item">
        <text class="label">手机号（可选）</text>
        <input
          type="number"
          maxlength="20"
          placeholder="请输入联系手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          class="input"
        />
      </view>

      <block wx:if="{{requiresOrganizationProfile}}">
        <view class="form-title organization-title">
          建立{{targetOrganizationTypeName}}组织
        </view>

        <view class="form-item">
          <text class="label">组织名称</text>
          <input
            placeholder="请输入企业或业务主体名称"
            value="{{organizationName}}"
            bindinput="onOrganizationNameInput"
            class="input"
          />
        </view>

        <view class="form-item">
          <text class="label">所在或负责区域</text>
          <input
            placeholder="例如：重庆市或四川省成都市"
            value="{{region}}"
            bindinput="onRegionInput"
            class="input"
          />
        </view>

        <view class="form-item">
          <text class="label">详细地址（可选）</text>
          <input
            placeholder="请输入详细地址"
            value="{{address}}"
            bindinput="onAddressInput"
            class="input"
          />
        </view>
      </block>

      <view class="form-item tip">
        <checkbox-group bindchange="onAgreeChange">
          <label class="checkbox-label">
            <checkbox value="agree" checked="{{agreed}}" />
            <text>我已阅读并同意</text>
            <text class="link" bindtap="openAgreement">《用户服务协议》</text>
            <text>及</text>
            <text class="link" bindtap="openPrivacy">《隐私政策》</text>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="action">
      <button
        class="accept-btn"
        bindtap="handleAccept"
        loading="{{accepting}}"
        disabled="{{accepting}}"
      >
        接受邀请并加入
      </button>
      <button class="reject-btn" bindtap="handleReject">
        暂不接受
      </button>
    </view>
  </block>
</view>