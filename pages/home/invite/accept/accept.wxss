/* pages/common/invite/accept/accept.wxss */

.container {
  min-height: 100vh;
  background: #f8f9fa;
}

.header {
  background: linear-gradient(135deg, #07c160, #009688);
  padding: 80rpx 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-bottom-left-radius: 50rpx;
  border-bottom-right-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

.user-info-row {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 8rpx solid white;
  flex-shrink: 0; 
}

.info-right {
  flex: 1;
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx; 
}
.role {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.9);
}

.invite-info {
  background: white;
  width: 100%;
  max-width: 650rpx;
  border-radius: 30rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.08);
  margin-bottom: 60rpx;
  text-align: left;      
}

.highlight-role {
  font-size: 52rpx;
  font-weight: bold;
  color: #07c160;
  margin: 40rpx 0;
  display: block;
}

.desc {
  font-size: 32rpx;
  color: #888;
  line-height: 1.6;
}

.profile-form {
  background: white;
  width: 100%;
  max-width: 650rpx;
  border-radius: 30rpx;
  padding: 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.08);
  margin-bottom: 80rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 50rpx;
  color: #333;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 32rpx;
  color: #333;
}

input {
  flex: 1;
  font-size: 32rpx;
  color: #666;
  padding: 10rpx 0;
}

.avatar-btn {
  flex: 1;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 20rpx;
  position: relative;
  height: 120rpx;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
}

.avatar-tip {
  position: absolute;
  left: 130rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 30rpx;
  color: #999;
}

.action {
  width: 100%;
  max-width: 650rpx;
  padding: 0 40rpx;
}

.accept-btn {
  background: #07c160;
  color: white;
  font-size: 36rpx;
  padding: 30rpx;
  border-radius: 60rpx;
  margin-bottom: 40rpx;
}

.accept-btn:active {
  background: #06a850;
}

.reject-btn {
  background: #f5f5f5;
  color: #999;
  font-size: 32rpx;
  padding: 25rpx;
  border-radius: 60rpx;
}

/* 新增：隐私同意区样式（与 edit 页面保持一致） */
.tip {
  display: flex;
  flex-direction: column;
  padding: 40rpx 0 20rpx;
  font-size: 22rpx;
  color: #e74c3c;
  line-height: 1.6;
}

.checkbox-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  color: #333;
  font-size: 28rpx;
}

.link {
  color: #07c160;
  text-decoration: underline;
  margin: 0 4rpx;
}


