.page {
  min-height: 100vh;
  padding: 26rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  color: #fff;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #07c160, #009688);
}

.summary-title {
  font-size: 36rpx;
  font-weight: 700;
}

.summary-count {
  font-size: 27rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #999;
  text-align: center;
  font-size: 30rpx;
}

.task-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-left: 8rpx solid #d9d9d9;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.05);
}

.task-card.new {
  border-left-color: #f5222d;
}

.task-card.read {
  border-left-color: #faad14;
}

.task-card.done {
  border-left-color: #52c41a;
  opacity: 0.78;
}

.task-top,
.task-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.domain {
  color: #07a85b;
  font-size: 25rpx;
}

.state {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.state.new {
  color: #cf1322;
  background: #fff1f0;
}

.state.read {
  color: #ad6800;
  background: #fffbe6;
}

.state.done {
  color: #237804;
  background: #f6ffed;
}

.task-title {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
}

.task-summary {
  display: block;
  margin-bottom: 18rpx;
  color: #666;
  font-size: 27rpx;
  line-height: 1.6;
}

.task-bottom {
  color: #999;
  font-size: 24rpx;
}

.need-action {
  color: #d4380d;
}

.ack-task {
  color: #888;
}

.opening {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07a85b;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: 28rpx;
}
