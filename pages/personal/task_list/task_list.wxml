<theme-shell business-context="{{true}}" root-organization="{{listContext}}" title-metric="{{attentionCount}} 项待关注" title-subtitle="{{unreadCount}} 未读 · {{actionPendingCount}} 待处理">
<view class="page">
  <view class="list-controls">
    <text>已加载 {{loadedCount}} 组任务</text>
    <button size="mini" bindtap="refreshTaskList" loading="{{refreshing}}" disabled="{{refreshing}}">刷新任务</button>
  </view>
  <view wx:if="{{hasUpdates}}" class="update-notice" bindtap="refreshTaskList">任务有更新，刷新查看 ›</view>
  <view wx:if="{{loading}}" class="empty">正在加载任务...</view>
  <view wx:elif="{{taskList.length === 0}}" class="empty">
    <text>{{loadError || '暂无任务'}}</text>
    <button wx:if="{{loadError}}" size="mini" bindtap="retryTaskList">重试加载</button>
  </view>

  <view wx:else class="task-list">
    <view
      wx:for="{{taskList}}"
      wx:key="cardKey"
      class="task-card {{item.stateClass}}"
      data-id="{{item.id}}"
      bindtap="openTask"
    >
      <view class="task-top">
        <text class="domain">{{item.domainName}}</text>
        <text class="state {{item.stateClass}}">{{item.stateText}}</text>
      </view>
      <text wx:if="{{item.root_organization.name}}" class="task-summary">根组织 · {{item.root_organization.name}}</text>
      <text class="task-title">{{item.title}}</text>
      <text wx:if="{{item.summary}}" class="task-summary">{{item.summary}}</text>
      <text wx:if="{{item.grouped && !item.isWorkorder && item.latest_summary}}" class="latest-summary">
        最近：{{item.latest_summary}}
      </text>
      <view class="task-bottom">
        <text>{{item.cursor_time}}</text>
        <text wx:if="{{item.grouped || item.isGoodsTransfer}}" class="group-entry">
          {{item.isGoodsTransfer ? (item.need_action ? '查看并处理 ›' : '查看流转进展 ›') : (item.isWorkorder ? '查看服务单 ›' : (item.isRecallGroup ? '进入召回详情 ›' : '进入任务详情 ›'))}}
        </text>
        <text wx:elif="{{item.need_action}}" class="need-action">需要处理</text>
        <text wx:else class="ack-task">查看即知晓</text>
      </view>
      <view wx:if="{{openingId === item.id}}" class="opening">正在打开...</view>
    </view>
  </view>
  <view wx:if="{{taskList.length > 0}}" class="pagination">
    <text wx:if="{{loadingMore}}">正在加载更多任务...</text>
    <block wx:elif="{{loadError}}">
      <text class="load-error">{{loadError}}</text>
      <button size="mini" bindtap="retryTaskList">重试加载</button>
    </block>
    <button wx:elif="{{hasMore}}" size="mini" bindtap="loadMore" disabled="{{refreshing}}">加载更多任务</button>
    <text wx:else>{{refreshing ? '正在刷新任务...' : '本次列表已加载完'}}</text>
  </view>
</view>

</theme-shell>
