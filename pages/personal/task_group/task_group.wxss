.page {
  min-height: 100vh;
  padding: 26rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.group-summary {
  margin-bottom: 24rpx;
  padding: 30rpx;
  color: #fff;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #07c160, #008f7a);
}

.group-top,
.child-top,
.child-bottom,
.group-metrics {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-title {
  font-size: 27rpx;
  font-weight: 600;
}

.group-count {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 23rpx;
}

.group-headline {
  display: block;
  margin: 22rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
}

.group-metrics {
  color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
}

.group-rule {
  display: block;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  color: #4b4b4b;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  line-height: 1.55;
}

.empty {
  padding: 120rpx 20rpx;
  color: #999;
  text-align: center;
  font-size: 29rpx;
}

.child-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  border-left: 8rpx solid #d9d9d9;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.05);
}

.child-card.new {
  border-left-color: #f5222d;
}

.child-card.read {
  border-left-color: #faad14;
}

.child-card.done {
  border-left-color: #52c41a;
  opacity: 0.82;
}

.domain {
  color: #07a85b;
  font-size: 25rpx;
}

.state {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.state.new {
  color: #cf1322;
  background: #fff1f0;
}

.state.read {
  color: #ad6800;
  background: #fffbe6;
}

.state.done {
  color: #237804;
  background: #f6ffed;
}

.child-title {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #222;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.5;
}

.child-summary {
  display: block;
  margin-bottom: 18rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.6;
}

.child-bottom {
  color: #999;
  font-size: 23rpx;
}

.child-action {
  color: #07a85b;
  font-weight: 600;
}

.opening {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07a85b;
  background: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}
