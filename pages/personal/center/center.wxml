<!-- pages/personal/center/center.wxml -->
<view class="container">
  <view class="header">
    <image
      wx:if="{{avatar_url}}"
      class="avatar"
      src="{{avatar_url}}"
      mode="aspectFill"
    />
    <view wx:else class="avatar avatar-placeholder">{{avatar_initial}}</view>
    <text class="title">渠道管理及\n售后服务系统</text>
    <text class="role">{{role_name || '游客'}}</text>
    <text class="welcome">欢迎，{{nickname || '用户'}}</text>
  </view>

  <view class="info-section">
    <view class="info-item">
      <text class="label">微信昵称</text>
      <text class="value">{{nickname || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">角色</text>
      <text class="value">{{role_name || '游客'}}</text>
    </view>
    <view class="info-item">
      <text class="label">区域</text>
      <text class="value">{{region || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">电话</text>
      <text class="value">{{phone || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="label">公司名称</text>
      <text class="value">{{company_name || '未绑定组织'}}</text>
    </view>
  </view>

  <view class="function-list">
    <navigator url="/pages/personal/edit/edit" class="function-item">
      <text class="text-left">编辑账号资料</text>
      <text class="arrow">›</text>
    </navigator>

    <view class="function-item task-row" bindtap="gotoTaskList">
      <text class="text-left">我的任务</text>
      <view class="right">
        <view wx:if="{{taskCount > 0}}" class="task-badge">
          {{taskCount > 99 ? '99+' : taskCount}}
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
