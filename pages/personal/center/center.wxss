.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 30rpx 0 60rpx;
  color: #fff;
  text-align: center;
  border-bottom-right-radius: 50rpx;
  border-bottom-left-radius: 50rpx;
  background: linear-gradient(135deg, #07c160, #009688);
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 22rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07a85b;
  background: #fff;
  font-size: 52rpx;
  font-weight: 700;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
}

.role {
  display: block;
  margin: 20rpx 0;
  opacity: 0.9;
  font-size: 36rpx;
}

.welcome {
  opacity: 0.8;
  font-size: 32rpx;
}

.info-section {
  margin: 60rpx 40rpx 40rpx;
  padding: 40rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.info-item:last-child {
  border-bottom: 0;
}

.label {
  width: 180rpx;
  flex-shrink: 0;
  color: #666;
  font-size: 32rpx;
}

.value {
  flex: 1;
  color: #333;
  text-align: left;
  font-size: 32rpx;
  font-weight: 500;
}

.function-list {
  margin: 0 40rpx 40rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
}

.function-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 26rpx 34rpx;
  border-bottom: 1rpx solid #eee;
  background: #fff;
}

.function-item:last-child {
  border-bottom: 0;
}

.function-item:active {
  background: #f8f9fa;
}

.text-left {
  flex: 1;
  color: #333;
  text-align: left;
  font-size: 34rpx;
  font-weight: 600;
}

.arrow {
  color: #bbb;
  font-size: 42rpx;
}

.task-row .right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-badge {
  display: inline-flex;
  min-width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #f5222d;
  font-size: 24rpx;
  line-height: 34rpx;
}
