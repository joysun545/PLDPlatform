<view class="page">
  <view class="card">
    <view class="section-title">可编辑资料</view>

    <view class="avatar-row">
      <button
        class="avatar-button"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{avatar_url}}"
          class="avatar"
          src="{{avatar_url}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar avatar-empty">选择头像</view>
      </button>
      <text class="avatar-tip">点击头像进行更换，支持JPG、PNG和WEBP</text>
    </view>

    <view class="form-item">
      <text class="label">微信昵称</text>
      <input
        class="input"
        type="nickname"
        maxlength="128"
        value="{{nickname}}"
        placeholder="请输入或选择微信昵称"
        bindinput="onNicknameInput"
      />
    </view>

    <view class="form-item">
      <text class="label">电话号码</text>
      <input
        class="input"
        type="number"
        maxlength="20"
        value="{{phone}}"
        placeholder="请输入电话号码"
        bindinput="onPhoneInput"
      />
    </view>
  </view>

  <view class="card readonly-card">
    <view class="section-title">组织身份（不可在此修改）</view>
    <view class="readonly-row">
      <text>岗位</text>
      <text>{{role_name}}</text>
    </view>
    <view class="readonly-row">
      <text>组织</text>
      <text>{{company_name}}</text>
    </view>
    <view class="readonly-row">
      <text>区域</text>
      <text>{{region}}</text>
    </view>
  </view>

  <button
    class="save-button"
    loading="{{saving}}"
    disabled="{{saving}}"
    bindtap="saveProfile"
  >保存账号资料</button>
</view>
