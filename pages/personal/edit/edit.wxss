.page {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.card {
  margin-bottom: 28rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  margin-bottom: 30rpx;
  color: #222;
  font-size: 34rpx;
  font-weight: 700;
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
}

.avatar-button {
  width: 132rpx;
  height: 132rpx;
  margin: 0 24rpx 0 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  background: transparent;
}

.avatar-button::after {
  border: 0;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07a85b;
  background: #e8f8f0;
  font-size: 25rpx;
}

.avatar-tip {
  flex: 1;
  color: #888;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #555;
  font-size: 29rpx;
}

.input {
  height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  background: #fafafa;
  font-size: 31rpx;
  box-sizing: border-box;
}

.readonly-card {
  color: #666;
}

.readonly-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 29rpx;
}

.readonly-row:last-child {
  border-bottom: 0;
}

.readonly-row text:last-child {
  flex: 1;
  color: #333;
  text-align: right;
}

.save-button {
  color: #fff;
  background: #07c160;
  font-size: 32rpx;
}
