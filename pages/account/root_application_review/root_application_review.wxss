@import "../root_application/root_application.wxss";
.toolbar .card-title { margin-bottom: 0; }
.reason-input { box-sizing: border-box; width: 100%; min-height: 200rpx; padding: 20rpx; border: 1rpx solid #d9e1e0; border-radius: 12rpx; font-size: 28rpx; }
.application-entry { position: relative; }
.application-entry .card-title { padding-right: 18rpx; }
.entry-label { display: block; text-align: right; margin-top: 16rpx; color: var(--ui-primary-bright); font-size: 28rpx; }
