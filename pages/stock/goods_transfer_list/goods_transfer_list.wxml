<view class="page">
  <view class="summary-card">
    <view>
      <text class="eyebrow">商品流转</text>
      <text class="summary-title">{{viewer ? viewer.organization_name : '当前组织'}}</text>
      <text class="summary-role" wx:if="{{viewer}}">{{viewer.role_name}}</text>
    </view>
    <button class="create-button" wx:if="{{viewer && (viewer.role === 'merchant_owner' || viewer.role === 'merchant_sales' || viewer.role === 'merchant_stock')}}" bindtap="createFlow">新建流转</button>
  </view>

  <view class="state-card" wx:if="{{loading}}">正在加载商品流转…</view>
  <view class="state-card error" wx:elif="{{errorMessage}}">
    <text>{{errorMessage}}</text>
    <button class="secondary-button" bindtap="retryLoad">重新加载</button>
  </view>
  <view class="state-card" wx:elif="{{items.length === 0}}">当前组织暂无商品流转记录</view>

  <view class="flow-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem">
    <view class="card-head">
      <text class="flow-type">{{item.flow_type_name}}</text>
      <text class="status-pill {{item.statusClass}}">{{item.status_name}}</text>
    </view>
    <text class="flow-no">{{item.flow_no}}</text>
    <text class="route">{{item.from_organization.name}} → {{item.to_organization.name}}</text>
    <view class="meta-row">
      <text>{{item.item_count}} 台 · {{item.initiated_by_name}}</text>
      <text>{{item.createdText}}</text>
    </view>
    <view class="action-row">
      <text class="terminal" wx:if="{{item.factory_lifecycle_terminated}}">已退回厂家，当前生命周期终止</text>
      <text class="action-text">{{item.actionText}} ›</text>
    </view>
  </view>
</view>
