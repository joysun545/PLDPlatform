.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  color: #202723;
  background: #f4f7f5;
}

.state-card,
.hero-card,
.rule-card,
.filter-wrap,
.empty-card,
.device-card {
  display: block;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(20, 45, 40, 0.06);
}

.state-card,
.empty-card { color: #6d7773; text-align: center; }
.state-card.error { color: #b63d31; }
.retry-button { width: 240rpx; margin-top: 22rpx; color: #087f5b; background: #e9f8f1; }
.retry-button::after,
.detail-button::after { border: 0; }

.hero-card { color: #fff; background: linear-gradient(135deg, #0ab779, #087f69); }
.hero-title,
.hero-org,
.hero-meta,
.summary-count,
.summary-label,
.rule-title,
.rule-text,
.device-sn,
.device-model,
.operation-meta { display: block; }
.hero-title { font-size: 36rpx; font-weight: 750; }
.hero-org { margin-top: 16rpx; font-size: 29rpx; font-weight: 600; }
.hero-meta { margin-top: 12rpx; font-size: 24rpx; opacity: .86; }

.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-bottom: 24rpx; }
.summary-card { padding: 24rpx; border-radius: 18rpx; text-align: center; background: #fff; }
.summary-card.reissue { color: #087f5b; background: #e9faf2; }
.summary-card.repair { color: #b65c00; background: #fff4df; }
.summary-card.disassembly { color: #8a4c23; background: #fff0e6; }
.summary-card.repairing { color: #2457a6; background: #eaf2ff; }
.summary-card.ended { color: #8e3b31; background: #fff0ed; }
.summary-count { font-size: 40rpx; font-weight: 750; }
.summary-label { margin-top: 6rpx; font-size: 23rpx; }

.rule-card { border-left: 8rpx solid #0a9a68; background: #f6fffa; }
.rule-title { font-size: 28rpx; font-weight: 700; }
.rule-text { margin-top: 12rpx; color: #567067; font-size: 24rpx; line-height: 1.7; }

.filter-wrap { padding: 0; }
.filter-field { display: flex; justify-content: space-between; padding: 24rpx 28rpx; color: #087f5b; font-size: 26rpx; }

.device-head,
.info-row,
.status-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.device-main { min-width: 0; }
.device-sn { font-size: 30rpx; font-weight: 700; }
.device-model { margin-top: 8rpx; color: #6c7672; font-size: 24rpx; }
.status-pill { flex-shrink: 0; max-width: 210rpx; padding: 8rpx 15rpx; border-radius: 999rpx; color: #087f5b; background: #e8f8f1; font-size: 22rpx; text-align: center; }
.info-row { margin-top: 17rpx; padding-top: 17rpx; border-top: 1rpx solid #edf0ef; color: #606a66; font-size: 23rpx; }
.info-row text:last-child { max-width: 430rpx; color: #222b27; text-align: right; word-break: break-all; }
.status-row { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; color: #5c6863; background: #f3f7f5; font-size: 22rpx; }
.operation-meta { margin-top: 12rpx; color: #76807c; font-size: 22rpx; }
.detail-button { margin-top: 20rpx; border-radius: 13rpx; color: #087f5b; background: #e8f8f1; font-size: 25rpx; }
