<theme-shell business-context="{{true}}" root-organization="{{detail.root_organization}}">
<view class="page">
  <view class="state-card" wx:if="{{loading}}">正在加载货品清单与物流信息…</view>
  <view class="state-card error" wx:elif="{{errorMessage}}">
    <text>{{errorMessage}}</text>
    <button class="secondary-button" bindtap="retryLoad">重新加载</button>
  </view>
  <block wx:elif="{{detail}}">
    <view class="header-card">
      <text class="eyebrow">商品流转单据</text>
      <view class="header-row"><text class="plan-code">{{detail.goods_transfer.flow_no}}</text><text class="state-pill">{{detail.state_name}}</text></view>
      <text class="merchant">{{detail.goods_transfer.from_organization_name}} → {{detail.goods_transfer.to_organization_name}}</text>
      <text class="meta">共 {{detail.goods_transfer.device_count}} 台｜实物状态：{{detail.physical_status_name}}</text>
    </view>
    <view class="independence-tip top-tip">{{detail.financial_message || '商家向下发货仅留存货品清单与物流单据，不生成应收账款。单据上传与确认收货并行推进。'}}</view>
    <button class="secondary-button" bindtap="openTransferDetail">查看发货与收货</button>
    <view class="section-card">
      <view class="section-head">
        <text class="section-title">货品清单</text>
        <text class="section-state">{{detail.statement.submitted ? '已提交' : '待提交'}}</text>
      </view>
      <view wx:if="{{detail.statement.submitted}}" class="statement-info">
        <text>提交人：{{detail.statement.submitted_by_name}}</text>
        <text>提交时间：{{detail.statement.submittedText}}</text>
        <button class="secondary-button" bindtap="previewStatement">查看货品清单图片</button>
      </view>
      <view wx:if="{{detail.actions.can_submit_statement}}" class="action-form">
        <text class="form-tip">上传本次发货的货品清单图片，清单仅作单据留存，不生成应收账款。</text>
        <button class="secondary-button" bindtap="chooseStatement">{{selectedStatementPath ? '已选择清单图片，点击更换' : '选择货品清单图片'}}</button>
        <image wx:if="{{selectedStatementPath}}" class="preview" src="{{selectedStatementPath}}" mode="aspectFill" />
        <button class="primary-button" loading="{{submittingStatement}}" disabled="{{submittingStatement}}" bindtap="submitStatement">提交货品清单</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">物流单据</text>
        <text class="section-state">共 {{detail.logistics_documents.length}} 份</text>
      </view>
      <view wx:if="{{detail.actions.can_upload_logistics}}" class="action-form">
        <text class="form-tip">物流单据可上传图片或 PDF，允许补充多份。</text>
        <view class="choice-row">
          <button class="secondary-button half" bindtap="chooseLogisticsImage">选择图片</button>
          <button class="secondary-button half" bindtap="chooseLogisticsPdf">选择 PDF</button>
        </view>
        <text wx:if="{{selectedLogisticsName}}" class="selected-file">已选择：{{selectedLogisticsName}}</text>
        <image wx:if="{{selectedLogisticsPath && selectedLogisticsType === 'IMAGE'}}" class="preview" src="{{selectedLogisticsPath}}" mode="aspectFill" />
        <input class="remark-input" value="{{logisticsRemark}}" maxlength="255" placeholder="物流单号或备注（选填）" bindinput="onLogisticsRemarkInput" />
        <button class="primary-button" loading="{{uploadingLogistics}}" disabled="{{uploadingLogistics || !selectedLogisticsPath}}" bindtap="submitLogistics">上传物流单据</button>
      </view>
      <view wx:if="{{detail.logistics_documents.length === 0}}" class="empty-tip">尚未上传物流单据</view>
      <view class="document-card" wx:for="{{detail.logistics_documents}}" wx:key="id">
        <view class="payment-head">
          <text class="payment-title">第 {{item.sequence_no}} 份物流单据</text>
          <text class="payment-state">{{item.file_type === 'PDF' ? 'PDF' : '图片'}}</text>
        </view>
        <text class="payment-meta">上传人：{{item.uploaded_by_name}}</text>
        <text class="payment-meta">上传时间：{{item.uploadedText}}</text>
        <text wx:if="{{item.remark}}" class="payment-meta">备注：{{item.remark}}</text>
        <button class="link-button" data-path="{{item.preview_path}}" data-type="{{item.file_type}}" bindtap="previewLogistics">查看物流单据</button>
      </view>
    </view>

  </block>
</view>
</theme-shell>
