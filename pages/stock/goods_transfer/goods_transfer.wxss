page {
  background: #f3f6f5;
  color: #17211d;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.hero-card,
.section-card,
.state-card {
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(15, 77, 54, 0.07);
}

.hero-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #067a4e, #07a86d 58%, #20c887);
  color: #fff;
}

.hero-eyebrow,
.hero-title,
.hero-tip,
.section-title,
.field-label,
.type-name,
.type-hint,
.flow-no,
.route,
.meta,
.device-sn,
.device-model,
.empty-tip {
  display: block;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.8;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.65;
  opacity: 0.9;
}

.section-card,
.state-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.state-card {
  color: #66756e;
  text-align: center;
}

.state-card.error {
  color: #b42318;
}

.section-title {
  font-size: 29rpx;
  font-weight: 700;
}

.type-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.type-card {
  flex: 1;
  padding: 22rpx 12rpx;
  border: 2rpx solid #e3ebe7;
  border-radius: 16rpx;
  text-align: center;
}

.type-card.active {
  border-color: #08a66d;
  background: #eafaf3;
  color: #067a4e;
}

.type-name {
  font-size: 28rpx;
  font-weight: 700;
}

.type-hint {
  margin-top: 8rpx;
  color: #718078;
  font-size: 20rpx;
  line-height: 1.4;
}

.field-label {
  margin-top: 24rpx;
  color: #43514a;
  font-size: 24rpx;
  font-weight: 600;
}

.picker-field {
  margin-top: 12rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid #d8e2dd;
  border-radius: 14rpx;
  background: #f8faf9;
  color: #8a9690;
  font-size: 24rpx;
}

.picker-field.selected {
  color: #17211d;
}

.rule-tip {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #08754e;
  font-size: 22rpx;
  line-height: 1.6;
}

.rule-tip.amber {
  background: #fff7e7;
  color: #9a5b00;
}

.rule-tip.danger {
  background: #fff1f0;
  color: #b42318;
}

.remark-input {
  box-sizing: border-box;
  width: 100%;
  height: 140rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #d8e2dd;
  border-radius: 14rpx;
  background: #f8faf9;
  font-size: 24rpx;
}

.primary-button,
.secondary-button,
.scan-button {
  margin-top: 22rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.primary-button {
  background: #079b65;
  color: #fff;
}

.secondary-button {
  background: #ecfdf5;
  color: #067a4e;
}

.scan-button {
  border: 2rpx solid #079b65;
  background: #fff;
  color: #079b65;
}

.primary-button::after,
.secondary-button::after,
.scan-button::after {
  border: 0;
}

.flow-head,
.section-head,
.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flow-type {
  font-size: 31rpx;
  font-weight: 700;
}

.status-pill {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  background: #eafaf3;
  color: #067a4e;
  font-size: 21rpx;
}

.flow-no {
  margin-top: 14rpx;
  color: #68766f;
  font-size: 22rpx;
}

.route {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.meta {
  margin-top: 10rpx;
  color: #718078;
  font-size: 22rpx;
}

.count {
  color: #079b65;
  font-size: 24rpx;
}

.empty-tip {
  margin-top: 18rpx;
  color: #718078;
  font-size: 23rpx;
  line-height: 1.6;
}

.device-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7eeea;
}

.device-main {
  min-width: 0;
}

.device-sn {
  font-size: 25rpx;
  font-weight: 650;
}

.device-model {
  margin-top: 7rpx;
  color: #718078;
  font-size: 21rpx;
}

.item-status {
  margin-left: 18rpx;
  color: #079b65;
  font-size: 22rpx;
  white-space: nowrap;
}
