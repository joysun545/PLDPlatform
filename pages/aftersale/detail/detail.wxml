<theme-shell>
<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取售后申请...</view>
  <view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button bindtap="backHome">返回首页</button></view>

  <block wx:elif="{{detail}}">
    <view class="hero">
      <text class="eyebrow">售后服务单</text>
      <text class="title">{{detail.viewer_stage.badge || detail.execution_stage_name || detail.status_name}}</text>
      <text>{{detail.case_no}}</text>
      <text class="stage" wx:if="{{detail.viewer_stage.mode === 'ACTION_REQUIRED'}}">当前步骤正在由您完成</text>
      <text class="stage" wx:elif="{{detail.viewer_stage.mode === 'COMPLETED'}}">已结案</text>
      <text class="stage" wx:else>当前真实流程</text>
    </view>

    <view class="card grid">
      <view class="row fold-heading" data-field="summaryExpanded" bindtap="toggleSection"><text class="section-title">申请人与设备</text><text class="link">{{summaryExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{summaryExpanded}}">
        <view><text>申请人</text><text class="strong">{{detail.applicant.name}}</text><text>{{detail.applicant.organization}}</text></view>
        <view><text>设备型号</text><text class="strong">{{detail.device.product_model}}</text><text>生命周期编码：{{detail.device.lifecycle_code || '-'}}</text><text wx:if="{{detail.device.physical_device_code}}">设备编码：{{detail.device.physical_device_code}}</text></view>
        <view><text>激活时间</text><text class="strong">{{detail.activation.activated_at || '未记录'}}</text></view>
        <view><text>质保期限</text><text class="strong">{{detail.warranty.summary || '待确认'}}</text></view>
      </block>
    </view>

    <view class="card">
      <view class="row fold-heading" bindtap="toggleBom"><text class="section-title">关键配套物料 BOM</text><text class="link">{{bomExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{bomExpanded}}">
        <view wx:for="{{detail.bom.key_materials}}" wx:key="material_id" class="bom-row">
          <text>{{item.material_name}}</text><text>{{item.specification_name || '未指定规格'}} × {{item.quantity}}</text>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="row fold-heading" data-field="reportExpanded" bindtap="toggleSection"><text class="section-title">故障描述与真实位置</text><text class="link">{{reportExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{reportExpanded}}">
        <text class="description">{{detail.fault_description}}</text>
        <text class="location">{{detail.location.name}}</text>
        <text class="muted">{{detail.location.address}}　{{detail.location.latitude}}, {{detail.location.longitude}}</text>
        <view class="media-list" wx:if="{{mediaFiles.length}}">
          <view wx:for="{{mediaFiles}}" wx:key="id" class="media-row" data-index="{{index}}" bindtap="openMedia">
            <text>{{item.purpose_name}} · {{item.media_type_name}}</text>
            <text class="link">{{item.loading ? '读取中' : '查看附件'}}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{detail.dispatch.route}}">
      <view class="row fold-heading" data-field="dispatchExpanded" bindtap="toggleSection"><text class="section-title">厂家处理信息</text><text class="link">{{dispatchExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{dispatchExpanded}}">
        <text>路径：{{detail.dispatch.route_name}}</text>
        <text>初步认定：{{detail.dispatch.preliminary_fault_type_name || '待判断'}}</text>
        <view wx:if="{{detail.dispatch.preliminary_fault_materials.length}}" class="station-materials">
          <text>初步疑似物料</text>
          <text wx:for="{{detail.dispatch.preliminary_fault_materials}}" wx:key="bom_item_id">{{item.material_name}} {{item.specification_name}}</text>
        </view>
        <text class="description">认定依据：{{detail.dispatch.diagnosis_note || '待填写'}}</text>
        <text class="description">处理方案：{{detail.dispatch.repair_plan || '待填写'}}</text>
        <view wx:if="{{detail.dispatch.assignee.name}}" class="contact">
          <text>执行人：{{detail.dispatch.assignee.name}}　{{detail.dispatch.assignee.role_name}}</text>
          <text>电话：{{detail.dispatch.assignee.phone || '未登记'}}</text>
          <text>地址：{{detail.dispatch.assignee.organization_address || '未登记'}}</text>
        </view>
      </block>
    </view>

    <view
      class="notice viewer-stage {{detail.viewer_stage.mode === 'COMPLETED' ? 'completed' : ''}}"
      wx:if="{{detail.viewer_stage.title}}"
    >
      <text class="notice-title">{{detail.viewer_stage.title}}</text>
      <text wx:if="{{detail.viewer_stage.message}}">{{detail.viewer_stage.message}}</text>
    </view>

    <view class="notice" wx:if="{{detail.viewer.is_applicant && detail.applicant_instruction.title}}">
      <text class="notice-title">{{detail.applicant_instruction.title}}</text>
      <text>{{detail.applicant_instruction.message}}</text>
      <text wx:if="{{detail.applicant_instruction.contact.phone}}">联系电话：{{detail.applicant_instruction.contact.phone}}</text>
      <text wx:if="{{detail.applicant_instruction.contact.organization_address}}">地址：{{detail.applicant_instruction.contact.organization_address}}</text>
      <text wx:if="{{detail.applicant_instruction.repair_plan}}">厂家方案：{{detail.applicant_instruction.repair_plan}}</text>
    </view>

    <view class="card action" wx:if="{{detail.actions.can_triage}}">
      <view class="row fold-heading" data-field="triageExpanded" bindtap="toggleSection"><text class="section-title">厂家售后经理：故障认定与指派</text><text class="link">{{triageExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{triageExpanded}}">
        <picker range="{{detail.triage_options.preliminary_fault_types}}" range-key="label" bindchange="onTriageFault">
          <view class="picker">初步故障认定：{{triage.faultIndex >= 0 ? detail.triage_options.preliminary_fault_types[triage.faultIndex].label : '请选择'}}</view>
        </picker>
        <view wx:if="{{triage.isComponentSuspected}}" class="suspected-materials">
          <text class="subheading">可能故障或需要更换的物料型号</text>
          <text class="tip">请从设备提交时冻结的 BOM 中勾选。选择原装车人员或服务站时，系统先核对对应组织是否有这些型号的可用库存。</text>
          <checkbox-group bindchange="onTriageMaterials">
            <label wx:for="{{triage.preliminaryMaterialOptions}}" wx:key="selection_value" class="check-row">
              <checkbox value="{{item.selection_value}}" checked="{{item.selected}}" />
              {{item.material_name}} {{item.specification_name}}
            </label>
          </checkbox-group>
          <text wx:if="{{!triage.preliminaryMaterialOptions.length}}" class="tip">该设备的 BOM 暂无可选物料型号。</text>
        </view>
        <textarea value="{{triage.diagnosisNote}}" bindinput="onTriageNote" placeholder="填写根据图片、视频、故障描述作出的判断依据"></textarea>
        <textarea value="{{triage.repairPlan}}" bindinput="onTriagePlan" placeholder="填写维修方案、注意事项和给发起人的说明"></textarea>
        <picker range="{{detail.triage_options.routes}}" range-key="label" bindchange="onTriageRoute">
          <view class="picker">处理路径：{{triage.routeIndex >= 0 ? detail.triage_options.routes[triage.routeIndex].label : '请选择'}}</view>
        </picker>
        <view wx:if="{{triage.route === 'ORIGINAL_INSTALLER'}}" class="station-selection">
          <text class="subheading">原装车操作人与配件校验</text>
          <text class="tip" wx:if="{{triage.originalInstallerLoading}}">正在追溯装车记录并核对组织配件库存…</text>
          <block wx:elif="{{triage.originalInstallerCheck}}">
            <text class="tip">{{triage.originalInstallerCheck.message}}</text>
            <view wx:for="{{triage.originalInstallerCheck.stock_checks}}" wx:key="bom_item_id" class="candidate-info">
              <text>{{item.material_name}} {{item.specification_name}}：{{item.available ? '有可用库存' : item.reason}}</text>
            </view>
            <view wx:if="{{triage.originalInstallerCheck.nearest_station}}" class="candidate-info">
              <text>仅推荐最近的合格服务站：{{triage.originalInstallerCheck.nearest_station.organization}}</text>
              <text>{{triage.originalInstallerCheck.nearest_station.distance_label}} · {{triage.originalInstallerCheck.nearest_station.contact_name}}</text>
              <text>{{triage.originalInstallerCheck.nearest_station.address}}</text>
              <text class="link" bindtap="callFallbackStation">联系服务站：{{triage.originalInstallerCheck.nearest_station.phone}}</text>
              <button disabled="{{submitting || triage.originalInstallerLoading}}" bindtap="confirmOriginalInstallerFallback">确认改派最近服务站</button>
            </view>
          </block>
          <text class="link" bindtap="loadOriginalInstallerCheck">重新校验</text>
        </view>
        <view wx:if="{{triage.route === 'SERVICE_STATION'}}" class="station-selection">
          <text class="subheading">推荐售后服务站</text>
          <text class="tip">先按厂家和物料库存筛选，再按线下距离推荐。请电话联系确认后，在下方选择一家。</text>
          <text wx:if="{{triage.stationRecommendationsLoading}}" class="tip">正在计算推荐服务站…</text>
          <text wx:elif="{{triage.stationRecommendationMessage}}" class="tip">{{triage.stationRecommendationMessage}}</text>
          <radio-group wx:if="{{triage.candidates.length}}" bindchange="onTriageCandidate">
            <view wx:for="{{triage.candidates}}" wx:key="station_application_id" class="station-option">
              <label class="station-choice">
                <radio value="{{index}}" checked="{{triage.candidateIndex == index}}" />
                <view class="station-main">
                  <text class="station-name">{{item.name}} · {{item.distance_label}}</text>
                  <text class="candidate-info">服务地点：{{item.service_location_name || item.address}}</text>
                  <text class="candidate-info">地址：{{item.address}}</text>
                  <text class="candidate-info">对接人：{{item.contact_name}}（{{item.role_name}}）</text>
                  <text class="candidate-info">可联系：{{item.phone || '未登记电话'}}</text>
                  <view wx:if="{{item.material_models.length}}" class="station-materials">
                    <text wx:for="{{item.material_models}}" wx:for-item="material" wx:key="index">库存匹配：{{material.material_name}} {{material.specification_name}}</text>
                  </view>
                </view>
              </label>
              <text wx:if="{{item.phone}}" class="link station-call" data-index="{{index}}" catchtap="callServiceStation">联系服务站</text>
            </view>
          </radio-group>
        </view>
        <picker wx:if="{{triage.candidates.length && triage.route !== 'SERVICE_STATION'}}" range="{{triage.candidates}}" range-key="name" bindchange="onTriageCandidate">
          <view class="picker">实际维修人：{{triage.candidateIndex >= 0 ? triage.candidates[triage.candidateIndex].name + '｜' + triage.candidates[triage.candidateIndex].organization : '请选择'}}</view>
        </picker>
        <view wx:if="{{triage.candidateIndex >= 0 && triage.route !== 'SERVICE_STATION'}}" class="candidate-info">
          <text>{{triage.candidates[triage.candidateIndex].role_name}}　{{triage.candidates[triage.candidateIndex].phone}}</text>
          <text>{{triage.candidates[triage.candidateIndex].address || triage.candidates[triage.candidateIndex].unavailable_reason}}</text>
        </view>
        <block wx:if="{{triage.route === 'THIRD_PARTY'}}">
          <input class="field" data-field="thirdPartyName" bindinput="onTriageThirdInput" placeholder="第三方维修店名称" />
          <input class="field" data-field="thirdPartyContactName" bindinput="onTriageThirdInput" placeholder="联系人姓名（可选）" />
          <input class="field" data-field="thirdPartyPhone" bindinput="onTriageThirdInput" placeholder="联系电话" />
          <input class="field" data-field="thirdPartyAddress" bindinput="onTriageThirdInput" placeholder="详细地址" />
        </block>
        <block wx:if="{{triage.route === 'REMOTE'}}">
          <text class="subheading">远程排障直接结案信息</text>
          <picker range="{{detail.final_fault_types}}" range-key="label" bindchange="onFinalFault"><view class="picker">最终故障类型：{{finalForm.faultIndex >= 0 ? detail.final_fault_types[finalForm.faultIndex].label : '请选择'}}</view></picker>
          <picker range="{{detail.solution_types}}" range-key="label" bindchange="onFinalSolution"><view class="picker">最终解决方案：{{finalForm.solutionIndex >= 0 ? detail.solution_types[finalForm.solutionIndex].label : '请选择'}}</view></picker>
          <checkbox-group bindchange="onFinalMaterials"><label class="check-row" wx:for="{{detail.final_material_options}}" wx:key="material_id"><checkbox value="{{item.bom_item_id || item.material_id}}" />{{item.material_name}} {{item.specification_name}}</label></checkbox-group>
          <view wx:for="{{finalForm.causeRows}}" wx:key="materialId" class="cause-row">
            <picker wx:if="{{item.causes.length}}" range="{{item.causes}}" range-key="label" data-material-id="{{item.materialId}}" bindchange="onFinalCause"><view class="picker">{{item.materialName}}根因：{{item.causeIndex >= 0 ? item.causes[item.causeIndex].label : '请选择'}}</view></picker>
            <text wx:else class="tip">{{item.materialName}}尚未维护根因列表</text>
          </view>
          <textarea value="{{finalForm.solutionNote}}" bindinput="onFinalNote" placeholder="填写最终解决方案说明"></textarea>
        </block>
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitTriage">{{triage.route === 'SERVICE_STATION' ? '确认并通知厂家与服务站' : '确认认定并派送/结案'}}</button>
      </block>
    </view>

    <view class="card action" wx:if="{{detail.actions.can_applicant_shipment}}">
      <view class="row fold-heading" data-field="applicantShipmentExpanded" bindtap="toggleSection"><text class="section-title">发起人：寄送设备维修</text><text class="link">{{applicantShipmentExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{applicantShipmentExpanded}}">
        <text class="tip">请上传寄送物流单据，再确认寄送。维修人确认收件后才会收到维修任务。</text>
        <aftersale-media-uploader files="{{actionMedia}}" max-count="9" allow-document="{{true}}" disabled="{{submitting}}" bindchange="onActionMediaChange" bindretry="onActionMediaRetry"></aftersale-media-uploader>
        <input class="field" data-field="shipmentCompany" value="{{shipmentCompany}}" bindinput="onShipmentInput" placeholder="物流公司" />
        <input class="field" data-field="shipmentTrackingNo" value="{{shipmentTrackingNo}}" bindinput="onShipmentInput" placeholder="物流单号" />
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitApplicantShipment">上传单据并确认寄送</button>
      </block>
    </view>

    <view class="card action" wx:if="{{detail.actions.can_repair_receipt}}">
      <view class="row fold-heading" data-field="repairReceiptExpanded" bindtap="toggleSection"><text class="section-title">维修执行人：确认收到设备</text><text class="link">{{repairReceiptExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{repairReceiptExpanded}}">
        <textarea value="{{receiptNote}}" bindinput="onRepairInput" data-field="receiptNote" placeholder="可填写收件检查说明"></textarea>
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRepairReceipt">确认已收到寄修设备</button>
      </block>
    </view>

    <view class="card" wx:if="{{detail.escalation.requested}}">
      <text class="section-title">无法维修处理记录</text>
      <view>申请：{{detail.escalation.requested === 'REPLACEMENT' ? '售后换新' : '返厂维修'}}</view>
      <view>原因：{{detail.escalation.reason}}</view>
      <view wx:if="{{detail.escalation.decision}}">厂家确认：{{detail.escalation.decision === 'REPLACEMENT' ? '售后换新' : '返厂维修'}}</view>
      <view wx:if="{{detail.escalation.receiving_address}}">厂家接收信息：{{detail.escalation.receiving_address}}</view>
      <view wx:if="{{detail.escalation.new_device_sn}}">换新设备SN：{{detail.escalation.new_device_sn}}</view>
      <text class="tip" wx:if="{{detail.execution_stage === 'PENDING_ESCALATION'}}">待厂家售后经理确认，当前维修已暂停。</text>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_escalation_request && repairActionMode === 'UNABLE'}}">
      <view class="repair-action-heading"><text class="section-title">无法维修：申请厂家处理</text>
        <button class="repair-mode-link" disabled="{{submitting}}" bindtap="showRepairComplete">返回确认维修完成</button></view>
      <text class="tip">确认当前无法维修时，申请售后换新或返厂维修，由厂家确认后执行。</text>
      <radio-group data-field="escalationRequested" bindchange="onEscalationChoice">
        <label class="check-row"><radio value="REPLACEMENT" checked="{{escalationRequested === 'REPLACEMENT'}}"/>售后换新</label>
        <label class="check-row"><radio value="FACTORY_REPAIR" checked="{{escalationRequested === 'FACTORY_REPAIR'}}"/>返厂维修</label>
      </radio-group>
      <radio-group wx:if="{{escalationRequested === 'FACTORY_REPAIR'}}" data-field="factoryReturnRoute" bindchange="onEscalationChoice">
        <label class="check-row"><radio value="DIRECT" checked="{{factoryReturnRoute === 'DIRECT'}}"/>直接寄厂维修，厂家直接寄回用户</label>
        <label class="check-row"><radio value="CHAIN" checked="{{factoryReturnRoute === 'CHAIN'}}"/>逐级返厂维修，修复后按原链路返回</label>
      </radio-group>
      <textarea data-field="escalationReason" value="{{escalationReason}}" bindinput="onRepairInput" placeholder="无法维修原因（必填）"/>

      <aftersale-media-uploader files="{{actionMedia}}" max-count="9" allow-document="{{false}}" disabled="{{submitting}}" bindchange="onActionMediaChange" bindretry="onActionMediaRetry"/>
      <button disabled="{{submitting}}" loading="{{submitting}}" bindtap="submitUnableRepair">提交无法维修申请</button>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_escalation_decide}}">
      <text class="section-title">厂家：确认处理方式</text>
      <radio-group wx:if="{{detail.escalation.requested === 'REPLACEMENT'}}" data-field="replacementExecutionMode" bindchange="onEscalationChoice">
        <label class="check-row"><radio value="LOCAL" checked="{{replacementExecutionMode === 'LOCAL'}}"/>原装车/服务站组织调用库存换新，沿渠道退旧补发</label>
        <label class="check-row"><radio value="FACTORY" checked="{{replacementExecutionMode === 'FACTORY'}}"/>旧机沿链路返厂，由厂家售后经理换新（仅统计）</label>
      </radio-group>
      <textarea data-field="escalationAddress" value="{{escalationAddress}}" bindinput="onRepairInput" placeholder="厂家接收地址、联系人、联系电话（必填）"/>
      <textarea data-field="escalationNote" value="{{escalationNote}}" bindinput="onRepairInput" placeholder="处理说明"/>
      <button wx:if="{{detail.escalation.requested === 'REPLACEMENT'}}" data-decision="REPLACEMENT" disabled="{{submitting}}" bindtap="submitEscalationDecision">同意售后换新</button>
      <button data-decision="FACTORY_REPAIR" disabled="{{submitting}}" bindtap="submitEscalationDecision">{{detail.escalation.requested === 'REPLACEMENT' ? '不同意换新，转返厂维修' : '确认返厂维修'}}</button>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_escalation_handover}}">
      <text class="section-title">实际持有人：交接原设备至厂家</text>
      <radio-group data-field="escalationHandoverMethod" bindchange="onEscalationChoice">
        <label class="check-row"><radio value="SHIPMENT" checked="{{escalationHandoverMethod === 'SHIPMENT'}}"/>物流寄送</label>
        <label class="check-row"><radio value="IN_PERSON" checked="{{escalationHandoverMethod === 'IN_PERSON'}}"/>现场交接</label>
      </radio-group>
      <block wx:if="{{escalationHandoverMethod === 'SHIPMENT'}}">
        <input class="field" data-field="escalationCompany" bindinput="onRepairInput" value="{{escalationCompany}}" placeholder="物流公司"/>
        <input class="field" data-field="escalationTracking" bindinput="onRepairInput" value="{{escalationTracking}}" placeholder="物流单号"/>
      </block>
      <textarea data-field="escalationHandoverNote" value="{{escalationHandoverNote}}" bindinput="onRepairInput" placeholder="交接说明（必填）"/>
      <aftersale-media-uploader files="{{actionMedia}}" max-count="9" allow-document="{{true}}" disabled="{{submitting}}" bindchange="onActionMediaChange" bindretry="onActionMediaRetry"/>
      <button disabled="{{submitting}}" bindtap="submitEscalationHandover">上传凭证并确认交接</button>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_escalation_receipt}}">
      <text class="section-title">{{detail.escalation.requires_replacement_flow_v6 && detail.escalation.decision === 'FACTORY_REPAIR' ? '厂家物流：取货确认' : '厂家：确认收到原设备'}}</text>
      <textarea data-field="escalationReceipt" value="{{escalationReceipt}}" bindinput="onRepairInput" placeholder="核对原设备SN、配件和外观，填写收件说明"/>
      <button disabled="{{submitting}}" bindtap="submitEscalationReceipt">确认收到原设备</button>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_replacement_deliver}}">
      <text class="section-title">厂家：登记换新交付</text>
      <text class="tip">先通过现有设备流转流程将同型号新设备交付本用户组织，再登记SN及交付凭证。新设备装车、绑定和激活仍按正常流程办理。</text>
      <input class="field" data-field="escalationNewSN" value="{{escalationNewSN}}" bindinput="onRepairInput" placeholder="实际交付的新设备SN"/>
      <textarea data-field="escalationDeliveryNote" value="{{escalationDeliveryNote}}" bindinput="onRepairInput" placeholder="换新交付说明（必填）"/>
      <aftersale-media-uploader files="{{actionMedia}}" max-count="9" allow-document="{{true}}" disabled="{{submitting}}" bindchange="onActionMediaChange" bindretry="onActionMediaRetry"/>
      <button disabled="{{submitting}}" bindtap="submitReplacementDelivery">登记新设备交付并通知用户</button>
    </view>
    <view class="card action" wx:if="{{detail.actions.can_replacement_confirm}}">
      <text class="section-title">用户：确认换新收货</text>
      <text>厂家登记的新设备SN：{{detail.escalation.new_device_sn}}</text>
      <input class="field" data-field="escalationNewSN" value="{{escalationNewSN}}" bindinput="onRepairInput" placeholder="填写实际收到的新设备SN"/>
      <button disabled="{{submitting}}" bindtap="submitReplacementConfirm">核对SN并确认收到换新设备</button>
    </view>

    <view class="card" wx:if="{{detail.can_start_factory_transport}}">
