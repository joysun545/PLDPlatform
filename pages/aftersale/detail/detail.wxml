        <input class="field" data-field="thirdAmount" bindinput="onThirdInput" placeholder="维修费用金额（元）" type="digit" />
        <textarea data-field="thirdRemark" bindinput="onThirdInput" placeholder="费用说明（可选）"></textarea>
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitThirdExpense">确认费用凭证</button>
      </block>
    </view>

    <view class="card action" wx:if="{{detail.actions.can_third_party_fault_material_return}}">
      <view class="row fold-heading" data-field="thirdPartyFaultMaterialReturnExpanded" bindtap="toggleSection"><text class="section-title">厂家售后经理：故障物料返还</text><text class="link">{{thirdPartyFaultMaterialReturnExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{thirdPartyFaultMaterialReturnExpanded}}">
        <aftersale-media-uploader files="{{actionMedia}}" max-count="9" allow-document="{{true}}" disabled="{{submitting}}" bindchange="onActionMediaChange" bindretry="onActionMediaRetry"></aftersale-media-uploader>
        <input class="field" data-field="thirdReturnCompany" bindinput="onThirdInput" placeholder="返还物流公司" />
        <input class="field" data-field="thirdReturnTrackingNo" bindinput="onThirdInput" placeholder="返还物流单号" />
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitThirdFaultReturn">确认故障物料已返还</button>
      </block>
    </view>

    <view class="card action" wx:if="{{detail.actions.can_factory_close || detail.factory_transport.can_finalize}}">
      <view class="row fold-heading" data-field="factoryCloseExpanded" bindtap="toggleSection"><text class="section-title">厂家售后经理：处理归因</text><text class="link">{{factoryCloseExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{factoryCloseExpanded}}">
        <picker range="{{detail.final_fault_types}}" range-key="label" bindchange="onFinalFault"><view class="picker">最终故障类型：{{finalForm.faultIndex >= 0 ? detail.final_fault_types[finalForm.faultIndex].label : '请选择'}}</view></picker>
        <picker range="{{detail.solution_types}}" range-key="label" bindchange="onFinalSolution"><view class="picker">最终解决方案：{{finalForm.solutionIndex >= 0 ? detail.solution_types[finalForm.solutionIndex].label : '请选择'}}</view></picker>
        <checkbox-group bindchange="onFinalMaterials"><label class="check-row" wx:for="{{detail.final_material_options}}" wx:key="material_id"><checkbox value="{{item.bom_item_id || item.material_id}}" />{{item.material_name}} {{item.specification_name}}</label></checkbox-group>
        <view wx:for="{{finalForm.causeRows}}" wx:key="materialId" class="cause-row">
          <picker wx:if="{{item.causes.length}}" range="{{item.causes}}" range-key="label" data-material-id="{{item.materialId}}" bindchange="onFinalCause"><view class="picker">{{item.materialName}}根因：{{item.causeIndex >= 0 ? item.causes[item.causeIndex].label : '请选择'}}</view></picker>
          <text wx:else class="tip">{{item.materialName}}尚未维护根因列表</text>
        </view>
        <textarea value="{{finalForm.solutionNote}}" bindinput="onFinalNote" placeholder="最终解决方案、责任归因及后续建议"></textarea>
        <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitFactoryClose">{{detail.factory_transport ? '确认归因，交厂家物流返件' : '确认整个售后服务完成'}}</button>
      </block>
    </view>

    <view class="card" wx:if="{{detail.final.closed_at}}">
      <view class="row fold-heading" data-field="finalResultExpanded" bindtap="toggleSection"><text class="section-title">结案结果</text><text class="link">{{finalResultExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{finalResultExpanded}}">
        <text>故障类型：{{detail.final.fault_type_name}}</text>
        <text>解决方案：{{detail.final.solution_type_name}}</text>
        <text class="description">{{detail.final.solution_note}}</text>
        <text class="muted">结案人：{{detail.final.closed_by}}　{{detail.final.closed_at}}</text>
      </block>
    </view>

    <view class="card" wx:if="{{detail.lifecycle_history.length}}">
      <view class="row fold-heading" data-field="lifecycleHistoryExpanded" bindtap="toggleSection"><text class="section-title">设备历史（安装、流转、维修）</text><text class="link">{{lifecycleHistoryExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{lifecycleHistoryExpanded}}">
        <view wx:for="{{detail.lifecycle_history}}" wx:key="id" class="history-row">
          <text>{{item.event_type_name}}</text>
          <text>{{item.organization || item.from_organization || '-'}}　{{item.created_at}}</text>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="row fold-heading" data-field="afterSalesHistoryExpanded" bindtap="toggleSection"><text class="section-title">售后处理记录</text><text class="link">{{afterSalesHistoryExpanded ? '收起' : '展开'}}</text></view>
      <block wx:if="{{afterSalesHistoryExpanded}}">
        <view wx:for="{{detail.history}}" wx:key="id" class="history-row">
          <text>{{item.event_type}}</text><text>{{item.actor || '系统'}}　{{item.created_at}}</text>
        </view>
      </block>
    </view>
  </block>
</view>

</theme-shell>
