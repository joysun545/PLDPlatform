page{background:#f4f7f6;color:#26332e}.page{min-height:100vh;padding:28rpx;box-sizing:border-box}.state{padding-top:42vh;text-align:center;color:#718078}.state text{display:block;margin-bottom:28rpx}.error{color:#b94d4d}.hero{display:flex;flex-direction:column;gap:10rpx;padding:38rpx 32rpx;margin-bottom:22rpx;border-radius:28rpx;background:linear-gradient(135deg,#08b879,#078f72);color:#fff}.eyebrow{font-size:24rpx;opacity:.84}.title{font-size:38rpx;font-weight:700}.stage{font-size:24rpx;opacity:.86}.card{padding:28rpx;margin-bottom:22rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(10,76,55,.06)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid view{padding:18rpx;border-radius:16rpx;background:#f6faf8}.grid text{display:block;color:#829088;font-size:23rpx}.strong{margin-top:8rpx;color:#26332e!important;font-size:25rpx!important;font-weight:700;word-break:break-all}.row{display:flex;justify-content:space-between;align-items:center}.section-title{display:block;margin-bottom:18rpx;font-size:31rpx;font-weight:700}.subheading{display:block;margin-top:28rpx;color:#087e51;font-weight:700}.link{color:#07986f}.muted,.tip{display:block;margin-top:10rpx;color:#75837c;font-size:23rpx;line-height:1.55}.description{display:block;margin-top:12rpx;line-height:1.72;white-space:pre-wrap}.location{display:block;margin-top:20rpx;font-weight:600}.bom-row,.media-row,.history-row{display:flex;justify-content:space-between;gap:20rpx;padding:19rpx 0;border-top:1rpx solid #edf1ef}.bom-row text:last-child,.history-row text:last-child{color:#718078;text-align:right;font-size:23rpx}.media-list{margin-top:20rpx;border-bottom:1rpx solid #edf1ef}.media-row{color:#087e51}.contact{display:flex;flex-direction:column;gap:8rpx;margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#eff9f3;font-size:24rpx}.notice{display:flex;flex-direction:column;gap:9rpx;padding:26rpx;margin-bottom:22rpx;border-left:8rpx solid #08a875;border-radius:16rpx;background:#ebfaf4;color:#52635b;line-height:1.6}.notice.completed{border-left-color:#6e8178;background:#f0f5f2}.notice-title{font-weight:700;color:#087e51}.action{border:2rpx solid #bfead4}.picker,.field,textarea{width:100%;box-sizing:border-box;margin-top:18rpx;padding:20rpx;border-radius:14rpx;background:#f6faf8;color:#33423a}.picker{min-height:40rpx}.field{height:82rpx}textarea{min-height:164rpx;line-height:1.6}.candidate-info{display:flex;flex-direction:column;gap:7rpx;margin-top:14rpx;padding:16rpx;background:#eef9f3;border-radius:12rpx;color:#537064;font-size:23rpx}.check-row{display:block;margin-top:17rpx;color:#4a5c53;font-size:25rpx}.switch-row{display:flex;justify-content:space-between;align-items:center;margin-top:22rpx;padding:16rpx 0;border-top:1rpx solid #edf1ef}button{margin-top:24rpx;color:#fff;background:#07a85d;border-radius:14rpx}.secondary{color:#087d4b!important;background:#eaf8f0!important}.history-row{flex-direction:column;gap:6rpx;font-size:24rpx}
