page{background:var(--ui-page-bg);color:var(--ui-ink)}.page{min-height:100vh;padding:28rpx;box-sizing:border-box}.state{padding-top:42vh;text-align:center;color:var(--ui-muted)}.state text{display:block;margin-bottom:28rpx}.error{color:#b94d4d}.hero{display:flex;flex-direction:column;gap:10rpx;padding:38rpx 32rpx;margin-bottom:22rpx;border-radius:var(--ui-panel-radius);background:linear-gradient(135deg,var(--ui-gradient-start),var(--ui-gradient-end));color:#fff}.eyebrow{font-size:24rpx;opacity:.84}.title{font-size:38rpx;font-weight:700}.stage{font-size:24rpx;opacity:.86}.card{padding:28rpx;margin-bottom:22rpx;border-radius:var(--ui-card-radius);background:#fff;box-shadow:var(--ui-card-shadow)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid view{padding:18rpx;border-radius:16rpx;background:var(--ui-primary-pale)}.grid text{display:block;color:var(--ui-muted);font-size:23rpx}.strong{margin-top:8rpx;color:var(--ui-ink)!important;font-size:25rpx!important;font-weight:700;word-break:break-all}.row{display:flex;justify-content:space-between;align-items:center}.section-title{display:block;margin-bottom:18rpx;font-size:31rpx;font-weight:700}.subheading{display:block;margin-top:28rpx;color:var(--ui-primary);font-weight:700}.link{color:var(--ui-primary)}.muted,.tip{display:block;margin-top:10rpx;color:var(--ui-muted);font-size:23rpx;line-height:1.55}.description{display:block;margin-top:12rpx;line-height:1.72;white-space:pre-wrap}.location{display:block;margin-top:20rpx;font-weight:600}.bom-row,.media-row,.history-row{display:flex;justify-content:space-between;gap:20rpx;padding:19rpx 0;border-top:1rpx solid var(--ui-border)}.bom-row text:last-child,.history-row text:last-child{color:var(--ui-muted);text-align:right;font-size:23rpx}.media-list{margin-top:20rpx;border-bottom:1rpx solid var(--ui-border)}.media-row{color:var(--ui-primary)}.contact{display:flex;flex-direction:column;gap:8rpx;margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:var(--ui-primary-soft);font-size:24rpx}.notice{display:flex;flex-direction:column;gap:9rpx;padding:26rpx;margin-bottom:22rpx;border-left:8rpx solid var(--ui-primary);border-radius:16rpx;background:var(--ui-primary-soft);color:var(--ui-ink);line-height:1.6}.notice.completed{border-left-color:#6e8178;background:#f0f5f2}.notice-title{font-weight:700;color:var(--ui-primary)}.action{border:2rpx solid var(--ui-border)}.picker,.field,textarea{width:100%;box-sizing:border-box;margin-top:18rpx;padding:20rpx;border-radius:var(--ui-control-radius);background:var(--ui-primary-pale);color:var(--ui-ink)}.picker{min-height:40rpx}.field{height:82rpx}textarea{min-height:164rpx;line-height:1.6}.candidate-info{display:flex;flex-direction:column;gap:7rpx;margin-top:14rpx;padding:16rpx;background:var(--ui-primary-soft);border-radius:12rpx;color:var(--ui-muted);font-size:23rpx}.check-row{display:block;margin-top:17rpx;color:var(--ui-ink);font-size:25rpx}.switch-row{display:flex;justify-content:space-between;align-items:center;margin-top:22rpx;padding:16rpx 0;border-top:1rpx solid var(--ui-border)}button{margin-top:24rpx;color:#fff;background:var(--ui-primary);border-radius:var(--ui-control-radius)}.secondary{color:var(--ui-primary)!important;background:var(--ui-primary-soft)!important}.history-row{flex-direction:column;gap:6rpx;font-size:24rpx}
