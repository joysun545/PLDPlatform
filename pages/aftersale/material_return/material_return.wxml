<theme-shell><view class="page"><text wx:if="{{error}}">{{error}}</text><view class="card" wx:if="{{detail}}"><text>售后三包退料（非销售结算）</text><text>供应商：{{detail.supplier}}</text><text>设备：{{detail.device_sn}}</text><text>物料：{{detail.material}} {{detail.specification}}</text><text>实际退回数量：{{detail.quantity}}</text><text>物流：{{detail.logistics.company}} {{detail.logistics.tracking_no}}</text><text>状态：{{detail.status}}</text><button wx:if="{{detail.can_receive}}" disabled="{{busy}}" bindtap="receive">线下核对后确认收料</button></view></view></theme-shell>
