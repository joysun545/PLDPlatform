<view class="page"><view class="hero"><text class="h1">{{pageTitle}}</text><text>{{pageSubtitle}}</text></view><view wx:if="{{!loading && !rows.length}}" class="empty">{{emptyText}}</view><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view><text class="no">{{item.case_no}}</text><text class="status">{{item.status_name}}</text></view><text class="title">{{item.product_model}}</text><text class="sub">{{item.sn}}｜{{item.execution_stage_name}}</text><text wx:if="{{!isCustomer}}" class="sub">申请人：{{item.applicant || '-'}}　执行人：{{item.assigned_user || '-'}}</text><text class="link">{{isCustomer ? '查看服务进展 ›' : '查看详情与处理 ›'}}</text></view></view>
