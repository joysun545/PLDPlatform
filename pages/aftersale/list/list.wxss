page{background:var(--ui-page-bg);color:var(--ui-ink)}.page{min-height:100vh;padding:28rpx}.hero{padding:36rpx;background:linear-gradient(135deg,var(--ui-gradient-start),var(--ui-gradient-end));border-radius:var(--ui-panel-radius);color:#fff}.hero text{display:block}.h1{font-size:44rpx;font-weight:700;margin-bottom:12rpx}.card,.empty{margin-top:24rpx;padding:30rpx;background:#fff;border-radius:var(--ui-card-radius)}.no{font-weight:700}.status{float:right;color:#07834f}.title,.sub,.link{display:block;margin-top:18rpx}.sub{color:var(--ui-muted)}.link{text-align:right;color:var(--ui-primary)}
