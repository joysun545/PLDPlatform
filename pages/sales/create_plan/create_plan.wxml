<view class="page">
  <view class="page-header">
    <text class="eyebrow">厂家销售</text>
    <text class="title">创建订单计划</text>
    <text class="subtitle">一个计划可包含多个品类、多个产品型号</text>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <text>正在加载直属商家和产品资料…</text>
  </view>

  <view class="state-card error" wx:elif="{{loadError}}">
    <text>{{loadError}}</text>
    <button class="secondary-button small" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:elif="{{createdPlan}}">
    <view class="success-card">
      <view class="success-icon">✓</view>
      <text class="success-title">订单计划创建成功</text>
      <text class="success-code">{{createdPlan.plan_code}}</text>
      <text class="success-tip">{{createdSuccessTip}}</text>
    </view>

    <view class="card">
      <view class="card-title-row">
        <text class="card-title">计划摘要</text>
        <text class="status-pill">{{createdPlan.status_name}}</text>
      </view>
      <view class="summary-row"><text>直接商家</text><text>{{createdPlan.merchant.name}}</text></view>
      <view class="summary-row"><text>负责区域</text><text>{{createdPlan.region}}</text></view>
      <view class="summary-row"><text>授权品牌</text><text>{{createdPlan.brand.name}}</text></view>
      <view class="summary-row"><text>计划总数</text><text>{{createdPlan.total_quantity}} 台</text></view>
    </view>

    <view class="card">
      <text class="card-title">型号批次与生命周期编码</text>
      <view class="created-item" wx:for="{{createdPlan.items}}" wx:key="id">
        <view class="created-item-head">
          <text>{{item.product_model_name}}</text>
          <text>× {{item.quantity}}</text>
        </view>
        <view class="created-split">
          <text>调用成品库存 {{item.return_inventory_quantity}} 台</text>
          <text>新生产 {{item.production_quantity}} 台</text>
        </view>
        <text class="code-line">订单批次：{{item.order_batch_code}}</text>
        <text class="code-line">生命周期：{{item.lifecycle_code}}</text>
      </view>
    </view>

    <button class="secondary-button detail-button" bindtap="openCreatedPlan">查看订单计划动态</button>
    <button class="primary-button" bindtap="createAnother">继续创建订单计划</button>
  </block>

  <block wx:elif="{{!loading && !loadError}}">
    <view class="card factory-card" wx:if="{{factory}}">
      <text class="label">创建厂家</text>
      <text class="factory-name">{{factory.name}}</text>
    </view>

    <view class="card">
      <text class="section-number">01</text>
      <text class="card-title">选择本人直属商家</text>
      <text class="helper">只显示由您本人邀请的商家负责人账号所在组织</text>

      <picker
        range="{{merchants}}"
        range-key="name"
        value="{{merchantIndex}}"
        bindchange="onMerchantChange"
        disabled="{{merchants.length === 0}}"
      >
        <view class="picker-field {{merchantIndex < 0 ? 'placeholder' : ''}}">
          {{merchantIndex >= 0 ? merchants[merchantIndex].name : (merchants.length ? '请选择直接商家' : '暂无本人直属商家')}}
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>

    <view class="card" wx:if="{{selectedMerchant}}">
      <view class="card-title-row">
        <view>
          <text class="section-number">02</text>
          <text class="card-title">区域与品牌</text>
        </view>
        <button
          class="text-button"
          wx:if="{{selectedMerchant.configured && !channelEditing}}"
          bindtap="editChannel"
        >修改</button>
      </view>

      <view class="channel-summary" wx:if="{{selectedMerchant.configured && !channelEditing}}">
        <view class="channel-value">
          <text class="label">负责区域</text>
          <text>{{selectedMerchant.region}}</text>
        </view>
        <view class="channel-value">
          <text class="label">授权品牌</text>
          <text>{{selectedMerchant.brand.name}}</text>
        </view>
      </view>

      <view wx:if="{{channelEditing}}">
        <text class="warning" wx:if="{{!selectedMerchant.configured}}">首次下单前，请先指定该商家的负责区域和品牌</text>
        <text class="field-label">负责区域</text>
        <input
          class="input-field"
          value="{{regionDraft}}"
          maxlength="255"
          placeholder="例如：四川省或成渝区域"
          bindinput="onRegionInput"
        />

        <text class="field-label">授权品牌</text>
        <picker range="{{brands}}" range-key="name" value="{{brandIndex}}" bindchange="onBrandChange">
          <view class="picker-field {{brandIndex < 0 ? 'placeholder' : ''}}">
            {{brandIndex >= 0 ? brands[brandIndex].name : '请选择授权品牌'}}
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>

        <view class="button-row">
          <button
            class="secondary-button"
            wx:if="{{selectedMerchant.configured}}"
            bindtap="cancelChannelEdit"
          >取消</button>
          <button
            class="primary-button compact"
            loading="{{savingChannel}}"
            disabled="{{savingChannel}}"
            bindtap="saveChannel"
          >保存区域与品牌</button>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{selectedMerchant.configured && selectedBrand && !channelEditing}}">
      <view class="card-title-row">
        <view>
          <text class="section-number">03</text>
          <text class="card-title">添加产品型号</text>
        </view>
        <button class="add-button" bindtap="addProductRow">＋ 添加</button>
      </view>
      <text class="helper">选择产品型号后，请在本页确定本次生产所用 BOM 版本。系统优先推荐该商家最近冻结的版本；首次下单默认最新有效版本。调用成品库存的设备仍保留原始 BOM 追溯。</text>
      <text class="bom-recommendation-tip" wx:if="{{bomRecommendationLoading}}">正在读取该商家的最近订单 BOM 推荐…</text>
      <text class="bom-recommendation-tip error" wx:elif="{{bomRecommendationError}}">{{bomRecommendationError}}</text>

      <view class="product-row" wx:for="{{productRows}}" wx:key="key">
        <view class="product-row-head">
          <text>产品 {{index + 1}}</text>
          <text
            class="remove-link"
            data-key="{{item.key}}"
            bindtap="removeProductRow"
          >删除</text>
        </view>

        <text class="field-label">产品品类</text>
        <picker
          range="{{categories}}"
          range-key="name"
          value="{{item.categoryIndex}}"
          data-key="{{item.key}}"
          bindchange="onCategoryChange"
        >
          <view class="picker-field {{item.categoryIndex < 0 ? 'placeholder' : ''}}">
            {{item.categoryIndex >= 0 ? categories[item.categoryIndex].name : '请选择产品品类'}}
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>

        <text class="field-label">产品型号</text>
        <picker
          range="{{item.models}}"
          range-key="name"
          value="{{item.modelIndex}}"
          data-key="{{item.key}}"
          bindchange="onModelChange"
          disabled="{{item.categoryIndex < 0}}"
        >
          <view class="picker-field {{item.modelIndex < 0 ? 'placeholder' : ''}}">
            {{item.modelIndex >= 0 ? item.models[item.modelIndex].name : (item.categoryIndex >= 0 ? '请选择产品型号' : '请先选择品类')}}
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>

        <text class="field-label">本次生产 BOM 版本</text>
        <picker
          range="{{item.bomOptions}}"
          range-key="display_name"
          value="{{item.bomIndex}}"
          data-key="{{item.key}}"
          bindchange="onBomChange"
          disabled="{{item.productModelId === '' || item.bomOptions.length === 0}}"
        >
          <view class="picker-field {{item.bomIndex < 0 ? 'placeholder' : ''}}">
            {{item.bomIndex >= 0 ? item.bomOptions[item.bomIndex].display_name : (item.productModelId ? '该型号暂无可选 BOM' : '请先选择产品型号')}}
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
        <text class="bom-tip" wx:if="{{item.bomIndex >= 0}}">本次订单将冻结 {{item.bomOptions[item.bomIndex].display_name}}，后续物料需求只按该冻结版本计算。</text>
        <text class="bom-source-tip" wx:if="{{item.selectedBomSourceName}}">{{item.selectedBomSourceName}}</text>

        <view class="bom-editor-card" wx:if="{{item.productModelId && item.sourceBomId}}">
          <view class="bom-editor-head">
            <view>
              <text class="bom-editor-title">本次订单 BOM 物料</text>
              <text class="bom-editor-subtitle">不编辑则沿用所选版本；修改后会在创建订单时冻结为新的 BOM 版本。</text>
            </view>
            <button
              class="bom-editor-toggle"
              data-key="{{item.key}}"
              bindtap="toggleBomEditor"
            >{{item.materialEditorVisible ? '收起物料' : '编辑物料'}}</button>
          </view>

          <block wx:if="{{item.materialEditorVisible}}">
            <view class="bom-editor-state" wx:if="{{item.materialEditorLoading}}">正在加载物料、规格和可选供应商…</view>
            <view class="bom-editor-state error" wx:elif="{{item.materialEditorError}}">
              <text>{{item.materialEditorError}}</text>
              <button class="retry-bom-button" data-key="{{item.key}}" bindtap="reloadBomMaterials">重新加载</button>
            </view>
            <block wx:elif="{{item.materialEditorLoaded}}">
              <text class="bom-editor-note">单台用量由所选BOM固定；可调整物料是否使用、规格、供应商和备注。未改动时不会创建新版本。</text>
              <view
                class="bom-material-card {{bomMaterial.deleted ? 'deleted' : ''}}"
                wx:for="{{item.bomMaterials}}"
                wx:for-item="bomMaterial"
                wx:for-index="materialIndex"
                wx:key="materialId"
              >
                <view class="bom-material-head">
                  <view>
                    <text class="bom-material-name">{{bomMaterial.name}}</text>
                    <text class="bom-material-code">{{bomMaterial.code}}</text>
                  </view>
                  <label class="delete-toggle">
                    <text>不使用</text>
                    <switch
                      color="#df5d5d"
                      checked="{{bomMaterial.deleted}}"
                      data-key="{{item.key}}"
                      data-material-index="{{materialIndex}}"
                      bindchange="onMaterialDeleteChange"
                    />
                  </label>
                </view>
                <text class="bom-material-meta" wx:if="{{bomMaterial.quantity}}">单台用量：{{bomMaterial.quantity}}</text>

                <view class="bom-material-fields" wx:if="{{!bomMaterial.deleted}}">
                  <text class="field-label">物料规格</text>
                  <picker
                    range="{{bomMaterial.specOptions}}"
                    range-key="name"
                    value="{{bomMaterial.specIndex}}"
                    data-key="{{item.key}}"
                    data-material-index="{{materialIndex}}"
                    bindchange="onMaterialSpecChange"
                  >
                    <view class="bom-picker-field">
                      {{bomMaterial.specOptions[bomMaterial.specIndex].name}}
                      <text class="picker-arrow">⌄</text>
                    </view>
                  </picker>

                  <text class="field-label">供应商</text>
                  <picker
                    range="{{bomMaterial.supplierOptions}}"
                    range-key="name"
                    value="{{bomMaterial.supplierIndex}}"
                    data-key="{{item.key}}"
                    data-material-index="{{materialIndex}}"
                    bindchange="onMaterialSupplierChange"
                  >
                    <view class="bom-picker-field">
                      {{bomMaterial.supplierOptions[bomMaterial.supplierIndex].name}}
                      <text class="picker-arrow">⌄</text>
                    </view>
                  </picker>

                  <text class="field-label">物料备注</text>
                  <input
                    class="bom-remark-input"
                    value="{{bomMaterial.remark}}"
                    maxlength="500"
                    placeholder="可填写该物料备注（选填）"
                    data-key="{{item.key}}"
                    data-material-index="{{materialIndex}}"
                    bindinput="onMaterialRemarkInput"
                  />
                </view>
              </view>
            </block>
          </block>
        </view>

        <text class="field-label">计划数量</text>
        <input
          class="input-field quantity"
          type="number"
          value="{{item.quantity}}"
          data-key="{{item.key}}"
          bindinput="onQuantityInput"
        />

        <view class="reissue-card" wx:if="{{item.productModelId}}">
          <view class="reissue-state" wx:if="{{item.reissueLoading}}">
            正在查询厂家成品库存…
          </view>
          <view class="reissue-state error" wx:elif="{{item.reissueError}}">
            {{item.reissueError}}
          </view>
          <block wx:elif="{{item.reissueInfo}}">
            <view class="reissue-head">
              <view>
                <text class="reissue-title">厂家成品库存</text>
                <text class="reissue-count">当前可用 {{item.reissueInfo.available_count}} 台</text>
              </view>
              <switch
                color="#07b85e"
                checked="{{item.useReturnInventory}}"
                disabled="{{item.reissueInfo.available_count <= 0}}"
                data-key="{{item.key}}"
                bindchange="onUseReturnInventoryChange"
              />
            </view>

            <view class="bom-compare">
              <view class="bom-compare-block">
                <text class="bom-label">成品库存设备实际BOM</text>
                <block wx:if="{{item.reissueInfo.return_inventory_boms.length}}">
                  <text
                    class="bom-line"
                    wx:for="{{item.reissueInfo.return_inventory_boms}}"
                    wx:for-item="bomRow"
                    wx:key="bom_id"
                  >{{bomRow.version}} · {{bomRow.count}} 台</text>
                </block>
                <text class="bom-empty" wx:else>暂无可用设备</text>
              </view>
              <view class="bom-compare-block">
                <text class="bom-label">该商家最近订单BOM</text>
                <text class="bom-line" wx:if="{{item.reissueInfo.recent_merchant_bom}}">
                  {{item.reissueInfo.recent_merchant_bom.version}}
                </text>
                <text class="bom-empty" wx:else>暂无历史订单</text>
              </view>
            </view>

            <view class="split-preview">
              <view><text>{{item.quantity}}</text><text>总需求</text></view>
              <view><text>{{item.returnInventoryQuantity}}</text><text>调用成品库存</text></view>
              <view><text>{{item.productionQuantity}}</text><text>新生产</text></view>
            </view>
            <text class="reissue-note" wx:if="{{item.useReturnInventory}}">
              系统提交时会逐台锁定成品库存设备；每台保留原BOM、原批次和原生命周期追溯。
            </text>
          </block>
        </view>
      </view>

      <button class="outline-button" bindtap="addProductRow">＋ 再添加一个产品型号</button>
    </view>

    <view class="card" wx:if="{{selectedMerchant.configured && selectedBrand && !channelEditing}}">
      <text class="section-number">04</text>
      <text class="card-title">订单备注</text>
      <textarea
        class="textarea-field"
        maxlength="2000"
        value="{{remark}}"
        placeholder="可填写交付要求或其他说明（选填）"
        bindinput="onRemarkInput"
      />
    </view>

    <button
      class="primary-button submit-button"
      wx:if="{{selectedMerchant.configured && selectedBrand && !channelEditing}}"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submitPlan"
    >确认创建订单计划</button>
  </block>
</view>
