<view class="page">
  <view class="page-header">
    <text class="eyebrow">物料库存订单协同</text>
    <text class="title">订单计划列表</text>
    <text class="subtitle" wx:if="{{viewer}}">{{viewer.organization_name}} · {{viewer.role_name}}</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x="true" enhanced="true">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="key" class="filter-item {{activeStatus === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="selectStatus">{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="state-card" wx:if="{{loading}}">正在加载订单计划…</view>
  <view class="state-card error" wx:elif="{{errorMessage}}">
    <text>{{errorMessage}}</text>
    <button class="retry-button" bindtap="retryLoad">重新加载</button>
  </view>
  <view class="state-card" wx:elif="{{plans.length === 0}}">当前筛选下暂无订单计划</view>

  <block wx:else>
    <view class="plan-card" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlan">
      <view class="plan-head">
        <view>
          <text class="plan-code">{{item.plan_code}}</text>
          <text class="plan-time">{{item.submittedText}}</text>
        </view>
        <text class="status-pill {{item.statusClass}}">{{item.status_name}}</text>
      </view>
      <view class="summary-grid">
        <view class="summary-cell"><text class="label">商家</text><text class="value">{{item.merchant.name}}</text></view>
        <view class="summary-cell"><text class="label">计划数量</text><text class="value">{{item.total_quantity}} 台</text></view>
        <view class="summary-cell"><text class="label">厂家销售经理</text><text class="value">{{item.sales_manager.name}}</text></view>
        <view class="summary-cell"><text class="label">品牌</text><text class="value">{{item.brand.name}}</text></view>
      </view>
      <view class="material-flow-tip">点击查看冻结 BOM、成品库存调用、物料预占、供应配送、型号生产计划及实时任务动态。</view>
      <view class="open-tip">查看订单计划详情 ›</view>
    </view>
  </block>
</view>
