page {
  background: #f4f7fb;
  color: #172033;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.state-card,
.header-card,
.section-card {
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.06);
}

.state-card {
  padding: 44rpx 28rpx;
  color: #64748b;
  text-align: center;
}

.state-card.error {
  color: #b91c1c;
}

.header-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #1d4ed8, #2563eb 58%, #60a5fa);
  color: #fff;
}

.eyebrow,
.plan-code,
.merchant,
.meta,
.form-tip,
.selected-name,
.selected-size,
.file-name,
.document-meta,
.document-remark,
.empty-tip {
  display: block;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  opacity: 0.8;
}

.plan-code {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.merchant {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.meta {
  margin-top: 9rpx;
  font-size: 23rpx;
  opacity: 0.84;
}

.parallel-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #eff6ff;
  color: #1e40af;
  font-size: 23rpx;
  line-height: 1.6;
}

.section-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.section-head,
.document-head,
.choose-row,
.selected-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 29rpx;
  font-weight: 700;
}

.section-state {
  color: #2563eb;
  font-size: 23rpx;
}

.form-tip,
.empty-tip {
  margin: 18rpx 0;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.65;
}

.choose-row {
  gap: 16rpx;
}

.primary-button,
.secondary-button,
.link-button {
  margin-top: 18rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.primary-button {
  background: #2563eb;
  color: #fff;
}

.secondary-button {
  background: #eff6ff;
  color: #1d4ed8;
}

.secondary-button.half {
  flex: 1;
  margin-right: 0;
  margin-left: 0;
  padding: 0 10rpx;
}

.secondary-button::after,
.link-button::after {
  border: 0;
}

.selected-file {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.selected-name {
  max-width: 76%;
  overflow: hidden;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-size {
  color: #64748b;
  font-size: 21rpx;
}

.remark-input {
  box-sizing: border-box;
  width: 100%;
  height: 150rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 25rpx;
}

.document-card {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e5e7eb;
}

.document-title {
  font-size: 27rpx;
  font-weight: 650;
}

.file-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 21rpx;
}

.file-name {
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
}

.document-meta,
.document-remark {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.document-remark {
  color: #334155;
}

.link-button {
  margin-left: 0;
  padding: 0;
  background: transparent;
  color: #1d4ed8;
  line-height: 58rpx;
  text-align: left;
}
