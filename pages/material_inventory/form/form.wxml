<view class="page">
  <view class="empty" wx:if="{{loading}}">正在加载…</view>
  <view class="notice error" wx:if="{{error}}">{{error}}<button class="secondary wide" wx:if="{{!ready}}" bindtap="load">重新加载</button></view>
  <view wx:if="{{ready && !success}}">
    <view class="notice">{{hint}}</view>
    <view class="notice" wx:if="{{pending}}">有一笔提交等待核验。请使用下方“核验并重试”，确认结果后再办理下一笔。</view>
    <view class="card" wx:if="{{choosing}}">
      <view class="title">选择供应商及物料规格</view>
      <view class="search field"><input class="input" placeholder="搜索供应商、物料或规格" value="{{query}}" bindinput="inputQuery" bindconfirm="search" confirm-type="search" /><button class="secondary" bindtap="search">查询</button></view>
      <view class="field" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" bindtap="choose">
        <view class="title">{{item.material_name}} · {{item.spec_name}}</view>
        <view class="code">{{item.spec_code}}</view><view class="subtitle">{{item.supplier_name}} ›</view><view class="divider"></view>
      </view>
      <view class="empty" wx:if="{{!catalogLoading && !options.length}}">没有符合条件的供货物料，请先由厂家配套经理核对供应关系和物料规格。</view>
      <view class="empty" wx:if="{{catalogLoading}}">正在查询…</view>
      <button class="secondary wide" wx:if="{{nextCursor && !catalogLoading}}" bindtap="more">加载更多</button>
    </view>
    <view class="card" wx:if="{{stock && !choosing}}">
      <view class="title">{{stock.material_name}} · {{stock.spec_name}}</view>
      <view class="code">{{stock.spec_code}}</view>
      <view class="subtitle">供应商：{{stock.supplier_name}}</view>
      <button wx:if="{{!pending && !lot && !warrantyCase}}" class="secondary wide" bindtap="chooseAgain">重新选择物料</button>
      <view class="field" wx:if="{{lot}}"><view class="code">批次：{{lot.batch_code}}</view><view class="muted">可用数量 {{lot.available}} {{stock.unit}}</view></view>
      <view class="field" wx:if="{{warrantyCase}}"><view class="code">三包记录：{{warrantyCase.case_no}}</view><view class="muted">故障件在库 {{warrantyCase.fault_on_hand}} · 待换回 {{warrantyCase.awaiting_replacement}} {{stock.unit}}</view></view>
      <view class="notice" wx:if="{{kind === 'WARRANTY_REGISTER'}}">{{source === 'STOCK' ? '来源：正常库存。确认后扣减该批次正常库存，转为故障件单独记录。' : '来源：线下收回的故障件。本次登记不增加正常物料库存。'}}</view>
      <view class="field"><text class="label">计量单位</text>
        <view class="select" wx:if="{{stock.unit}}">{{stock.unit}}</view>
        <picker wx:else range="{{units}}" value="{{unitIndex}}" bindchange="unit" disabled="{{pending}}"><view class="select">{{units[unitIndex]}}　⌄</view></picker>
        <view class="muted" wx:if="{{!stock.unit}}">首次确认后，该厂家、供应商和物料规格固定使用此单位。</view>
      </view>
      <view class="field"><text class="label">本次实际数量</text><input class="input" type="digit" maxlength="20" value="{{quantity}}" placeholder="请输入实际数量" bindinput="quantity" disabled="{{pending}}" /></view>
      <view class="field" wx:if="{{kind === 'RECEIPT' || kind === 'WARRANTY_REPLACE'}}"><text class="label">供应商原始批号（可留空）</text><input class="input" maxlength="128" value="{{supplierBatchCode}}" placeholder="有原始批号时填写" bindinput="supplierBatch" disabled="{{pending}}" /></view>
      <button class="primary wide" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{pending ? '核验并重试上次提交' : '确认' + title}}</button>
    </view>
  </view>
  <view class="card" wx:if="{{success}}">
    <view class="title">{{success.kind_label}}已记录</view>
    <view class="row">本次数量 {{success.quantity}} {{stock.unit || units[unitIndex]}}</view>
    <view class="code">{{success.document_no}}</view>
    <view wx:if="{{success.batch_code}}" class="code">批次：{{success.batch_code}}</view>
    <view wx:if="{{success.case_no}}" class="code">三包记录：{{success.case_no}}</view>
    <button class="primary wide" bindtap="done">查看物料库存</button>
  </view>
</view>
