page { background: #f4f7f6; color: #243d35; }
.page { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 6rpx 22rpx rgba(25,73,55,.04); }
.title { font-size: 34rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.subtitle, .muted { color: #65786f; font-size: 26rpx; line-height: 1.7; overflow-wrap: break-word; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.row > view { min-width: 0; }
.number { font-weight: 600; font-size: 34rpx; color: #04835f; }
.notice { padding: 22rpx; background: #eaf7f1; border-radius: 16rpx; font-size: 27rpx; line-height: 1.7; margin-bottom: 22rpx; }
.error { color: #a03a2b; background: #fff1eb; }
.empty { padding: 48rpx 24rpx; text-align: center; color: #65786f; line-height: 1.8; }
.field { margin: 24rpx 0; }
.label { display: block; font-size: 28rpx; margin-bottom: 12rpx; }
.input, .select { display: flex; align-items: center; width: 100%; height: 96rpx; min-height: 96rpx; box-sizing: border-box; padding: 0 24rpx; background: #f2f6f4; border: 1rpx solid #dce7e1; border-radius: 14rpx; font-size: 30rpx; line-height: normal; }
.search { display: flex; align-items: center; gap: 16rpx; margin-bottom: 22rpx; }
.search .input { flex: 1; min-width: 0; }
button { font-size: 28rpx; margin: 0; border-radius: 14rpx; min-height: 82rpx; line-height: 1.5; padding: 20rpx 24rpx; }
button::after { border: 0; }
.primary { background: #08b374; color: #fff; }
.secondary { background: #eaf7f1; color: #047451; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 22rpx 0; }
.actions button { flex: 1; min-width: 180rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.tabs button { flex: 1; padding: 20rpx 8rpx; font-size: 27rpx; }
.tabs .active { background: #08b374; color: white; }
.code { font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; }
.divider { border-top: 1rpx solid #e6ece8; margin: 20rpx 0; }
.wide { width: 100%; margin-top: 24rpx; }
.check { margin: 16rpx 0 26rpx; font-size: 26rpx; color: #65786f; }
