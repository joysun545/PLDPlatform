page { background: #f3f6f8; color: #17202a; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }
.state { margin-top: 220rpx; text-align: center; color: #73808a; }
.state.error { display: flex; flex-direction: column; gap: 24rpx; color: #c94242; }
.heading { display: flex; flex-direction: column; gap: 10rpx; padding: 32rpx; color: #fff; border-radius: 22rpx; background: linear-gradient(145deg, #08b77a, #078f79); }
.document-type { font-size: 22rpx; opacity: .82; }
.title { font-size: 40rpx; font-weight: 750; }
.model-name { font-size: 25rpx; opacity: .9; }
.content-card { margin-top: 22rpx; padding: 34rpx 30rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(31,45,61,.06); }
.content { white-space: pre-wrap; font-size: 29rpx; line-height: 1.95; }
.footer-space { height: 150rpx; }
.footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -6rpx 20rpx rgba(25,40,52,.08); }
.confirm-btn { color: #fff; background: #07c160; border-radius: 14rpx; font-weight: 700; }
.confirm-btn[disabled] { color: #71837a; background: #dce8e2; }
