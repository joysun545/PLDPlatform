page { background: #f3f6f8; color: #17202a; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.card { margin-top: 100rpx; padding: 38rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(31,45,61,.06); }
.title { display: block; color: #087d4b; font-size: 40rpx; font-weight: 750; }
.desc { display: block; margin-top: 24rpx; color: #63717b; line-height: 1.8; }
.device { display: block; margin: 22rpx 0; color: #8b969e; }
button { margin-top: 28rpx; color: #fff; background: #07c160; border-radius: 14rpx; }
