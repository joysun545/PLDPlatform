page { background: #f3f6f8; color: #17202a; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }
.state { margin-top: 180rpx; text-align: center; color: #718096; }
.state.error { display: flex; flex-direction: column; gap: 18rpx; }
.state-title { color: #d64545; font-size: 34rpx; font-weight: 700; }
.hero { padding: 34rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(145deg, #08bd79, #079e79); box-shadow: 0 14rpx 30rpx rgba(7,158,121,.2); display: flex; flex-direction: column; gap: 10rpx; }
.hero-label { font-size: 24rpx; opacity: .85; }
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sn { font-family: monospace; font-size: 25rpx; opacity: .9; }
.hero-role { margin-top: 10rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,.25); }
.card { margin-top: 24rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(31,45,61,.06); }
.card-title { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 700; }
.row { display: flex; padding: 17rpx 0; border-bottom: 1rpx solid #edf1f3; }
.row:last-of-type { border-bottom: 0; }
.label { width: 170rpx; color: #7a8792; }
.value { flex: 1; text-align: right; }
.time-line { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; text-align: center; color: #06855a; background: #edf9f4; }
.time-line.expired { color: #c33; background: #fff0f0; }
.blocked { margin-top: 24rpx; padding: 24rpx; color: #b53a3a; background: #fff0f0; border-radius: 16rpx; line-height: 1.6; }
.existing-tip { display: flex; flex-direction: column; gap: 10rpx; margin-top: 24rpx; padding: 24rpx; color: #176d47; background: #eaf9f1; border-left: 8rpx solid #08a963; border-radius: 16rpx; line-height: 1.6; }
.existing-title { font-size: 28rpx; font-weight: 700; }
.form-tip { display: block; margin-bottom: 20rpx; color: #718096; font-size: 24rpx; }
.field { margin-bottom: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.input, .picker-value { min-height: 82rpx; padding: 0 22rpx; border: 1rpx solid #dbe3e8; border-radius: 12rpx; background: #fafcfd; box-sizing: border-box; display: flex; align-items: center; }
.input { width: 100%; }
.placeholder { color: #a0aab2; }
.agreement { display: flex; align-items: flex-start; gap: 10rpx; color: #5d6872; font-size: 24rpx; line-height: 1.55; }
.agreement checkbox { transform: scale(.8); }
.accept-btn { margin: 28rpx 0 50rpx; height: 92rpx; line-height: 92rpx; color: #fff; background: #07c160; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; }
.accept-btn[disabled] { color: #fff; background: #a9cabe; }
