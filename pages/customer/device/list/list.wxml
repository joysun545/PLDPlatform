<view class="page">
  <view class="state" wx:if="{{loading}}">正在读取我的设备...</view>
  <view class="state error" wx:elif="{{error}}">
    <text class="state-title">无法打开设备清单</text>
    <text>{{error}}</text>
    <button class="secondary-btn" bindtap="goHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="hero">
      <text class="hero-label">我的设备</text>
      <text class="hero-title">{{customer.organization_name}}</text>
      <text class="hero-role">{{customer.role_name}} · {{customer.region || '区域未填写'}}</text>
      <view class="summary">
        <view class="summary-item"><text class="summary-value">{{total}}</text><text>全部设备</text></view>
        <view class="summary-item"><text class="summary-value">{{activatedCount}}</text><text>已激活</text></view>
        <view class="summary-item"><text class="summary-value">{{pendingActivationCount}}</text><text>待激活</text></view>
      </view>
    </view>

    <view class="empty" wx:if="{{!vehicles.length}}">
      <text class="empty-title">还没有绑定设备</text>
      <text>完成商家安装并接受设备邀请后，设备会显示在这里。</text>
    </view>

    <view class="vehicle-section" wx:for="{{vehicles}}" wx:key="id" wx:for-item="vehicle">
      <view class="vehicle-head">
        <view class="vehicle-info">
          <text class="vehicle-label">绑定车辆</text>
          <text class="vehicle-title">{{vehicle.vehicle_no}}</text>
          <text wx:if="{{vehicle.sharing_text}}" class="sharing-text">{{vehicle.sharing_text}}</text>
          <text wx:elif="{{vehicle.can_share_driver}}" class="sharing-empty">当前未与司机共享</text>
        </view>
        <button wx:if="{{vehicle.can_share_driver}}" class="share-btn" open-type="share" data-token="{{vehicle.shareToken}}" data-vehicle="{{vehicle.vehicle_no}}" disabled="{{!vehicle.shareToken}}">一键分享给司机</button>
      </view>
    <view class="device-card" wx:for="{{vehicle.devices}}" wx:key="id" data-id="{{item.id}}" bindtap="openDevice">
      <view class="device-head">
        <view class="device-heading">
          <text class="category">{{item.category}}</text>
          <text class="model">{{item.product_model}}</text>
        </view>
        <text class="status {{item.activation_status === 'ACTIVATED' ? 'activated' : ''}}">{{item.activation_status_name}}</text>
      </view>
      <text class="sn">{{item.sn}}</text>
      <view class="meta-grid">
        <view class="meta"><text class="meta-label">安装状态</text><text>{{item.install_status_name}}</text></view>
        <view class="meta"><text class="meta-label">使用车辆</text><text>{{item.vehicle_no || '未填写'}}</text></view>
        <view class="meta"><text class="meta-label">来源商家</text><text>{{item.source_organization || '-'}}</text></view>
        <view class="meta"><text class="meta-label">绑定时间</text><text>{{item.accepted_at_text || '-'}}</text></view>
      </view>
      <view class="open-line">查看参数和生命周期数据 ›</view>
    </view>
    </view>
  </block>
</view>
