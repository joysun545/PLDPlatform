page { background: #f3f6f8; color: #17202a; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }
.state { margin-top: 180rpx; text-align: center; color: #718096; }
.state.error { display: flex; flex-direction: column; gap: 18rpx; }
.state-title { color: #d64545; font-size: 34rpx; font-weight: 700; }
.secondary-btn { margin-top: 24rpx; color: #44515c; background: #fff; border-radius: 14rpx; }
.hero { padding: 34rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(145deg, #08b77a, #078f79); box-shadow: 0 14rpx 30rpx rgba(7,143,121,.2); }
.hero-label { display: block; font-size: 24rpx; opacity: .85; }
.hero-title { display: block; margin-top: 10rpx; font-size: 38rpx; font-weight: 700; }
.hero-role { display: block; margin-top: 8rpx; opacity: .9; }
.summary { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.25); }
.summary-item { display: flex; flex-direction: column; align-items: center; gap: 5rpx; font-size: 22rpx; }
.summary-value { font-size: 37rpx; font-weight: 700; }
.empty { display: flex; flex-direction: column; gap: 14rpx; margin-top: 28rpx; padding: 70rpx 38rpx; color: #74818a; background: #fff; border-radius: 20rpx; text-align: center; line-height: 1.6; }
.empty-title { color: #29343c; font-size: 31rpx; font-weight: 700; }
.device-card { margin-top: 24rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(31,45,61,.06); }
.device-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.device-heading { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }
.category { color: #078d5f; font-size: 23rpx; }
.model { font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.status { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 999rpx; color: #a16600; background: #fff6dd; font-size: 22rpx; }
.status.activated { color: #087d4b; background: #e6f8ef; }
.sn { display: block; margin-top: 14rpx; color: #66737c; font-family: monospace; }
.meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 22rpx; }
.meta { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; padding: 16rpx; border-radius: 12rpx; background: #f6faf8; font-size: 23rpx; word-break: break-all; }
.meta-label { color: #8a959d; font-size: 21rpx; }
.open-line { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf1f3; color: #078d5f; text-align: right; font-size: 24rpx; }
