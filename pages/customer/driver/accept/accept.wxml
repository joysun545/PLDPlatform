<view class="page">
  <view class="state" wx:if="{{loading}}">正在读取车辆分享信息...</view>
  <view class="state error" wx:elif="{{error}}">
    <text class="state-title">无法打开车辆邀请</text>
    <text>{{error}}</text>
    <button class="secondary-btn" bindtap="goHome">返回首页</button>
  </view>

  <block wx:elif="{{detail}}">
    <view class="hero">
      <text class="hero-label">司机车辆设备邀请</text>
      <text class="hero-title">{{detail.vehicle.vehicle_no}}</text>
      <text class="hero-subtitle">{{detail.owner.organization_name}}</text>
    </view>

    <view class="tip">
      接受后，该车辆当前及以后新增的设备都会显示在司机的“我的设备”中。
    </view>

    <view class="card">
      <view class="card-title">邀请信息</view>
      <view class="row"><text class="label">用户负责人</text><text class="value">{{detail.owner.nickname}}</text></view>
      <view class="row"><text class="label">绑定车辆</text><text class="value">{{detail.vehicle.vehicle_no}}</text></view>
      <view class="row"><text class="label">设备数量</text><text class="value">{{detail.vehicle.device_count}} 台</text></view>
    </view>

    <view class="card">
      <view class="card-title">车辆设备</view>
      <view class="device" wx:for="{{detail.vehicle.devices}}" wx:key="id">
        <view class="device-main"><text class="device-name">{{item.product_model}}</text><text class="device-sn">{{item.sn}}</text></view>
        <text class="device-status">{{item.activation_status === 'ACTIVATED' ? '已激活' : '待激活'}}</text>
      </view>
    </view>

    <view class="accepted" wx:if="{{detail.accepted_by_me}}">您已加入这辆车，可以直接查看车辆设备。</view>
    <button class="primary-btn" wx:if="{{detail.accepted_by_me}}" bindtap="openDevices">进入我的设备</button>
    <button class="primary-btn" wx:elif="{{detail.acceptance_allowed}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="acceptInvitation">确认加入并查看设备</button>
    <view class="blocked" wx:else>{{detail.blocked_reason || '当前邀请不能接受'}}</view>
  </block>
</view>
