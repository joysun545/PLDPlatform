page { background: #f4f7f5; color: #203129; font-size: 28rpx; }
.page { padding: 28rpx; }
.hero { padding: 34rpx; border-radius: 28rpx; background: linear-gradient(135deg,#07c160,#078f62); color: #fff; box-shadow: 0 14rpx 34rpx rgba(7,143,98,.18); }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { margin-top: 12rpx; opacity: .88; line-height: 1.55; }
.grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 20rpx; margin-top: 24rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 22rpx; box-shadow: 0 8rpx 24rpx rgba(31,65,48,.06); }
.menu-card { min-height: 150rpx; }
.card-title { font-size: 32rpx; font-weight: 650; color: #183e2d; }
.card-value { margin-top: 14rpx; font-size: 42rpx; font-weight: 700; color: #07a963; }
.muted { color: #84928b; line-height: 1.55; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.tag { padding: 7rpx 18rpx; border-radius: 999rpx; background: #e8f8ef; color: #078f62; font-size: 24rpx; }
.tag.warn { background: #fff2d7; color: #a56a00; }
.tag.danger { background: #fde8e8; color: #c23b3b; }
.empty { padding: 120rpx 30rpx; text-align: center; color: #98a39e; }
.error { margin: 28rpx 0; color: #c23b3b; text-align: center; }
.primary { margin-top: 20rpx; background: #07b967 !important; color: #fff !important; border-radius: 18rpx; }
.secondary { margin-top: 20rpx; background: #e9f8f0 !important; color: #078f62 !important; border-radius: 18rpx; }
.danger-btn { margin-top: 20rpx; background: #d9534f !important; color: #fff !important; border-radius: 18rpx; }
.field { margin-top: 20rpx; }
.label { display: block; margin-bottom: 10rpx; color: #65736c; }
.input,.textarea,.picker { box-sizing: border-box; width: 100%; padding: 22rpx; border-radius: 16rpx; background: #f3f7f5; }
.textarea { min-height: 150rpx; }
.section-title { margin-top: 34rpx; font-size: 34rpx; font-weight: 700; }
.divider { height: 1rpx; background: #edf0ee; margin: 22rpx 0; }
.link-hint { margin-top: 18rpx; color: #078f62; text-align: right; }
.kv { margin-top: 12rpx; display: flex; justify-content: space-between; gap: 24rpx; }
.kv-label { color: #84928b; flex-shrink: 0; }
.kv-value { text-align: right; word-break: break-all; }
.action-bar { display: grid; grid-template-columns: repeat(2,1fr); gap: 16rpx; margin-top: 24rpx; }
.action-bar button { width: 100%; margin: 0; }
.device-row { padding: 18rpx 0; border-bottom: 1rpx solid #edf0ee; }
.status-line { margin-top: 12rpx; color: #65736c; }
.filter-scroll { margin-top: 22rpx; white-space: nowrap; }
.filter-tabs { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 8rpx; }
.filter-tab { padding: 16rpx 24rpx; border-radius: 999rpx; background: #fff; color: #65736c; box-shadow: 0 5rpx 16rpx rgba(31,65,48,.05); }
.filter-tab.active { background: #07a963; color: #fff; }
