@import "../common.wxss";
.device { border-left: 8rpx solid #08aa64; }
.selected { box-shadow: 0 0 0 4rpx rgba(7,193,96,.24); }
.action-panel { border: 2rpx solid #bdebd3; }
.small { font-size: 24rpx; }
.tip { margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #eefaf4; color: #35604b; font-size: 26rpx; line-height: 1.6; }
.section-subtitle { margin: 28rpx 0 14rpx; font-size: 29rpx; font-weight: 700; color: #173d2e; }
.method-current { margin-top: 20rpx; font-size: 28rpx; font-weight: 700; color: #07965a; }
.supplier-progress { margin: 16rpx 0; padding: 18rpx; border-radius: 14rpx; background: #f5f8f7; color: #48655d; font-size: 25rpx; line-height: 1.7; }
.method-btn { margin-top: 16rpx; border: 2rpx solid #08aa64; background: #effbf5; color: #078c54; }
.compact { margin-top: 16rpx; font-size: 26rpx; }
.method-help { margin: 8rpx 12rpx 20rpx; font-size: 24rpx; }
.pickup-box { margin-top: 22rpx; padding-top: 6rpx; border-top: 2rpx solid #edf2ef; }
.inline-pickers { display: flex; gap: 16rpx; }
.inline-pickers picker { flex: 1; }
.transfer-code { margin-top: 26rpx; padding: 22rpx; border: 2rpx dashed #08aa64; border-radius: 18rpx; text-align: center; }
.transfer-qr { width: 420rpx; height: 420rpx; margin: 12rpx auto; }
.batch-panel { border: 3rpx solid #08aa64; }
.batch-picker { margin-top: 24rpx; font-weight: 600; }
.batch-route { margin: 18rpx 0 10rpx; font-size: 28rpx; color: #173d2e; }
.batch-selection { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; margin: 22rpx 0 12rpx; }
.batch-selection button { margin: 0; font-size: 24rpx; }
.batch-selection text { font-weight: 700; color: #078c54; }
.batch-device-list { max-height: 480rpx; margin-top: 18rpx; background: #f5f9f7; border-radius: 12rpx; }
.batch-device { display: flex; align-items: center; padding: 18rpx; border-bottom: 1rpx solid #e3ede7; font-size: 27rpx; }
.batch-device text { margin-left: 12rpx; overflow-wrap: anywhere; }
.batch-blocked { margin-top: 24rpx; padding: 18rpx; background: #fff8e9; color: #825d22; font-size: 24rpx; line-height: 1.7; }
.batch-empty { margin-top: 24rpx; }
.refresh-btn { margin: 0; font-size: 23rpx; }
