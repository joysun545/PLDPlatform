page { background: #f3f7f5; color: #173f32; }
.page { padding: 28rpx 26rpx 60rpx; }
.hero { padding: 42rpx 36rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg,#08bd68,#058a64); box-shadow: 0 18rpx 42rpx rgba(4,139,91,.18); }
.hero-kicker { font-size: 20rpx; letter-spacing: 4rpx; opacity: .72; }
.hero-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 700; }
.hero-sub { margin-top: 18rpx; font-size: 27rpx; opacity: .92; }
.hero-time { margin-top: 12rpx; font-size: 22rpx; opacity: .68; }
.state-card,.section-card { margin-top: 24rpx; padding: 32rpx; background:#fff; border-radius:28rpx; box-shadow:0 8rpx 28rpx rgba(23,63,50,.06); }
.state-card { text-align:center; color:#81928b; }
.state-card.error { color:#c64e4e; }
.section-head { display:flex; align-items:center; }
.domain-icon { width:72rpx; height:72rpx; line-height:72rpx; text-align:center; border-radius:22rpx; background:#e6f8ef; color:#05975e; font-weight:700; }
.section-copy { flex:1; margin-left:20rpx; }
.section-title { font-size:32rpx; font-weight:700; }
.section-sub { margin-top:6rpx; font-size:23rpx; color:#8b9994; }
.arrow { font-size:46rpx; color:#9bb0a8; }
.metric-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16rpx; margin-top:26rpx; }
.metric { padding:24rpx; border-radius:20rpx; background:#f4faf7; }
.metric-value { color:#079a60; font-size:38rpx; font-weight:700; }
.unit { margin-left:4rpx; font-size:21rpx; font-weight:500; }
.metric-name { margin-top:8rpx; color:#71827b; font-size:24rpx; }
.section-note { margin-top:20rpx; padding:18rpx; border-radius:16rpx; color:#70817a; background:#f7f9f8; font-size:22rpx; line-height:1.6; }
.footer-note { margin:34rpx 16rpx 0; text-align:center; color:#9aa7a2; font-size:22rpx; line-height:1.6; }
