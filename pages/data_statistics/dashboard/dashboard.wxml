<view class="page">
  <view class="hero">
    <view class="hero-kicker">DATA STATISTICS</view>
    <view class="hero-title">{{dashboardName}}</view>
    <view class="hero-sub">{{organizationName}} · {{roleName}}</view>
    <view class="hero-time" wx:if="{{generatedAt}}">更新于 {{generatedAt}}</view>
  </view>

  <view class="state-card" wx:if="{{loading}}">正在汇总业务数据…</view>
  <view class="state-card error" wx:elif="{{error}}">{{error}}</view>
  <view class="state-card" wx:elif="{{!sections.length}}">当前岗位暂无可查看的统计模块</view>

  <view class="section-card" wx:for="{{sections}}" wx:key="domain" bindtap="openDomain" data-domain="{{item.domain}}">
    <view class="section-head">
      <view class="domain-icon">{{item.icon}}</view>
      <view class="section-copy">
        <view class="section-title">{{item.title}}</view>
        <view class="section-sub">{{item.subtitle}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="metric-grid">
      <view class="metric" wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="code">
        <view class="metric-value">{{metric.value}}<text class="unit">{{metric.unit}}</text></view>
        <view class="metric-name">{{metric.name}}</view>
      </view>
    </view>
    <view class="section-note" wx:if="{{item.metric_note}}">口径说明：{{item.metric_note}}</view>
  </view>

  <view class="footer-note">统计页面只读，不会修改订单、库存、售后或质量业务状态。</view>
</view>
