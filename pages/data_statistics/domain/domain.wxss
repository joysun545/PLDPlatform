page{background:#f3f7f5;color:#173f32}.page{padding:28rpx 26rpx 60rpx}.hero{padding:38rpx 34rpx;border-radius:30rpx;color:#fff;background:linear-gradient(135deg,#08bd68,#058a64)}.hero-title{font-size:40rpx;font-weight:700}.hero-sub{margin-top:12rpx;font-size:24rpx;opacity:.8}.state,.note,.chart{margin-top:24rpx;padding:30rpx;border-radius:26rpx;background:#fff}.state{text-align:center;color:#84938e}.error{color:#c44}.metric-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:24rpx}.metric{padding:26rpx;border-radius:22rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(23,63,50,.05)}.value{font-size:38rpx;font-weight:700;color:#079a60}.value text{font-size:21rpx;margin-left:4rpx}.name{margin-top:8rpx;color:#74847e;font-size:24rpx}.note{font-size:23rpx;line-height:1.65;color:#687b73;background:#eaf7f0}.chart-title{font-size:29rpx;font-weight:700;text-transform:capitalize}.bar-row{margin-top:24rpx}.bar-head{display:flex;justify-content:space-between;font-size:23rpx;color:#52675f}.track{height:16rpx;margin-top:10rpx;border-radius:10rpx;background:#e8efec;overflow:hidden}.bar{height:100%;border-radius:10rpx;background:linear-gradient(90deg,#09bd69,#069b70)}.empty{padding:30rpx 0 10rpx;text-align:center;color:#98a49f;font-size:23rpx}
.tree-panel{margin-top:24rpx;padding:30rpx 22rpx;border-radius:26rpx;background:#fff;overflow:hidden}.tree-title{padding:0 8rpx;font-size:31rpx;font-weight:700}.tree-subtitle{padding:10rpx 8rpx 0;color:#82918b;font-size:22rpx;line-height:1.55}.tree-legend{display:flex;gap:30rpx;padding:22rpx 8rpx 8rpx;color:#60736b;font-size:22rpx}.legend-dot{display:inline-block;width:14rpx;height:14rpx;margin-right:8rpx;border-radius:50%}.legend-dot.inventory{background:#0aa36a}.legend-dot.activated{background:#ef9d35}.tree-row{box-sizing:border-box;margin-top:16rpx;padding:22rpx;border:1rpx solid #dce9e3;border-radius:20rpx;background:#fbfdfc;transition:all .2s}.tree-row.actor-node{border-left:8rpx solid #08a86a;background:#f0faf5}.tree-row.organization-node{border-left:8rpx solid #9bcfba}.tree-node-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.tree-node-name-wrap{display:flex;min-width:0;align-items:flex-start}.tree-node-text{min-width:0}.tree-toggle{width:34rpx;flex:none;color:#079a60;font-size:28rpx;line-height:40rpx}.tree-node-name{overflow:hidden;color:#173f32;font-size:27rpx;font-weight:700;line-height:1.45;text-overflow:ellipsis;white-space:nowrap}.tree-node-type{margin-top:4rpx;color:#87958f;font-size:20rpx}.tree-total-devices{flex:none;padding:7rpx 12rpx;border-radius:14rpx;background:#e4f5ec;color:#087f56;font-size:20rpx}.tree-counts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:18rpx}.tree-count{padding:14rpx;border-radius:14rpx;background:#fff}.total-count{background:#eaf7f0}.own-count{border:1rpx solid #e4ece8}.count-caption{color:#7b8d85;font-size:19rpx}.count-values{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:7rpx;color:#3d554b;font-size:22rpx;font-weight:600}.inventory-text{color:#078b5b}.activated-text{color:#d47a16}.tree-secondary{margin-top:12rpx;color:#788b82;font-size:20rpx}.tree-definition{margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:#f3f7f5;color:#71837b;font-size:21rpx;line-height:1.65}
.tree-level{flex:none;padding:7rpx 12rpx;border-radius:14rpx;background:#e4f5ec;color:#087f56;font-size:20rpx}.flow-total-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:18rpx}.flow-total-card{padding:20rpx 16rpx;border-radius:16rpx}.inventory-card{background:#e8f7ef;color:#078b5b}.activated-card{background:#fff2df;color:#c87313}.flow-number{font-size:36rpx;font-weight:700}.flow-label{margin-top:5rpx;font-size:21rpx;opacity:.78}
