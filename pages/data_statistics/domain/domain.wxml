<theme-shell>
<view class="page">
  <view class="hero"><view class="hero-title">{{title}}</view><view class="hero-sub">当前岗位授权范围 · 实时业务口径</view></view>
  <view class="state" wx:if="{{loading}}">正在加载统计数据…</view>
  <view class="state error" wx:elif="{{error}}">{{error}}</view>
  <block wx:else>
    <view class="metric-grid">
      <view class="metric" wx:for="{{metrics}}" wx:key="code"><view class="value">{{item.value}}<text>{{item.unit}}</text></view><view class="name">{{item.name}}</view></view>
    </view>
    <view class="note" wx:if="{{note}}">口径说明：{{note}}</view>
    <view class="warehouse-panel" wx:if="{{showWarehouseLots}}">
      <view class="warehouse-title">物料批次历史清单</view>
      <view class="warehouse-subtitle">按入库时间倒序保留全部批次，包括已用完或已退完的历史批次；本页只读。</view>
      <view class="search warehouse-search">
        <input class="input" placeholder="输入供应商、物料、规格或批次筛选" value="{{warehouseQuery}}" bindinput="inputWarehouseQuery" bindconfirm="searchWarehouseLots" confirm-type="search" />
        <button class="secondary" bindtap="searchWarehouseLots">查询</button>
      </view>
      <view class="warehouse-error" wx:if="{{warehouseError}}">{{warehouseError}}</view>
      <view class="warehouse-lot" wx:for="{{warehouseLots}}" wx:key="id">
        <view class="warehouse-lot-head"><view>{{item.material_name}} · {{item.spec_name}}</view><view class="lot-status">{{item.status}}</view></view>
        <view class="warehouse-code">{{item.batch_code}}</view>
        <view class="warehouse-subtitle">供应商：{{item.supplier_name}} · {{item.received_at}}</view>
        <view class="warehouse-numbers">入库 {{item.received}} {{item.unit}}　当前 {{item.on_hand}}　可用 {{item.available}}　预占 {{item.reserved}}</view>
        <view class="warehouse-subtitle" wx:if="{{item.supplier_batch_code}}">供应商原始批号：{{item.supplier_batch_code}}</view>
      </view>
      <view class="empty" wx:if="{{!warehouseLoading && !warehouseError && !warehouseLots.length}}">暂无符合条件的物料批次</view>
      <view class="empty" wx:if="{{warehouseLoading}}">正在加载批次清单…</view>
      <button wx:if="{{warehouseNextCursor && !warehouseLoading}}" class="secondary wide" bindtap="moreWarehouseLots">加载更多</button>
    </view>
    <view class="warehouse-panel" wx:if="{{showRepairBasis}}">
      <view class="warehouse-title">维修与换件结算依据</view>
      <view class="warehouse-subtitle">统计归属：{{repairBasisScopeTitle}}</view>
      <view class="warehouse-subtitle">同一设备多次独立维修分别计台次；实际换件数量累计计件次。依据已具备不代表已付款或已结算。点击记录查看售后凭证。</view>
      <view class="warehouse-lot" wx:for="{{basisRows}}" wx:key="application_id" data-id="{{item.application_id}}" bindtap="openRepairCase">
        <view class="warehouse-lot-head"><view>{{item.case_no}}</view><view class="lot-status">{{item.status_name}}</view></view>
        <view class="warehouse-code">设备SN：{{item.sn}} · 依据编号：{{item.basis_no}}</view>
        <view class="warehouse-subtitle">维修组织：{{item.organization_name}} · 执行人：{{item.executor_name}}</view>
        <view class="warehouse-subtitle">完工：{{item.repair_completed_at}}</view>
        <view class="warehouse-subtitle">结果确认：{{item.confirmed_at}} · 确认方式：{{item.confirmation_mode}}</view>
        <view class="warehouse-subtitle">厂家结案：{{item.closed_at}}</view>
        <view class="warehouse-numbers" wx:if="{{item.status === 'READY'}}">维修 {{item.repair_visits}} 台次 · 换件 {{item.replacement_pieces}} 件次</view>
        <view class="warehouse-subtitle" wx:if="{{item.materialsText}}">{{item.materialsText}}</view>
        <view class="warehouse-error" wx:if="{{item.issuesText}}">{{item.issuesText}}</view>
      </view>
      <view class="empty" wx:if="{{!basisLoading && !basisError && !basisRows.length}}">当前授权范围暂无维修完成记录</view>
      <view class="empty" wx:if="{{basisLoading}}">正在加载结算依据…</view>
      <button class="secondary wide" wx:if="{{basisError}}" bindtap="retryRepairBasis">{{basisError}} · 重试</button>
      <button class="secondary wide" wx:if="{{basisNextCursor && !basisLoading}}" bindtap="moreRepairBasis">加载更多依据</button>
    </view>
    <view class="tree-panel" wx:if="{{hasResponsibilityTree}}">
      <view class="tree-title">产品流转链路</view>
      <view class="tree-subtitle">链路库存包含本组织及全部下级；组织库存只计算本组织。点击卡片逐级查看。</view>
      <view
        class="tree-row {{item.nodeType === 'RESPONSIBILITY_ACCOUNT' ? 'actor-node' : 'organization-node'}}"
        wx:for="{{treeNodes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="toggleTreeNode"
        style="margin-left:{{item.indent}}rpx"
      >
        <view class="tree-node-head">
          <view class="tree-node-name-wrap">
            <text class="tree-toggle">{{item.hasChildren ? (item.expanded ? '▾' : '▸') : '•'}}</text>
            <view class="tree-node-text">
              <view class="tree-node-name">{{item.name}}</view>
              <view class="tree-node-type">{{item.nodeType === 'RESPONSIBILITY_ACCOUNT' ? '责任账号' : '组织节点'}}<text wx:if="{{item.roleCode}}"> · {{item.roleCode}}</text></view>
            </view>
          </view>
          <view class="tree-level">{{item.hasChildren ? (item.expanded ? '收起' : '展开') : (item.isMerchantOrganization && item.hasSubordinateOrganizations ? '下级暂无流转数据' : '末级')}}</view>
        </view>
        <view class="flow-total-cards">
          <view class="flow-total-card inventory-card"><view class="flow-number">{{item.primaryInventory}}</view><view class="flow-label">{{item.inventoryLabel}}</view></view>
          <view class="flow-total-card organization-card" wx:if="{{item.showOrganizationInventory}}"><view class="flow-number">{{item.ownInventory}}</view><view class="flow-label">组织库存</view></view>
          <view class="flow-total-card activated-card"><view class="flow-number">{{item.primaryActivated}}</view><view class="flow-label">{{item.activatedLabel}}</view></view>
          <view class="flow-total-card inventory-card" wx:if="{{item.showInstallationCount}}"><view class="flow-number">{{item.primaryInstalled}}</view><view class="flow-label">{{item.installedLabel}}</view></view>
        </view>
        <view class="tree-node-scope" wx:if="{{item.totalTransit}}">
          <text>当前链路在途 {{item.totalTransit}} 台</text>
        </view>
      </view>
    </view>
    <view class="chart" wx:for="{{charts}}" wx:key="code">
      <view class="chart-title">{{item.title}}</view>
      <view class="empty" wx:if="{{!item.rows.length}}">暂无可展示的数据</view>
      <view class="bar-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="label">
        <view class="bar-head"><text>{{row.label}}</text><text>{{row.value}}</text></view>
        <view class="track"><view class="bar" style="width:{{row.width}}%"></view></view>
      </view>
    </view>
  </block>
</view>

</theme-shell>
