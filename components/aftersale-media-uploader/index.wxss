.uploader{margin-top:18rpx}.capture-panel{padding:28rpx 24rpx;border:2rpx dashed #8dcdb0;border-radius:20rpx;background:#f4fbf7;text-align:center}.capture-title{display:block;color:#17372a;font-size:30rpx;font-weight:700}.capture-tip{display:block;margin:12rpx 0 22rpx;color:#627069;font-size:24rpx}.camera-button{width:100%;margin:0!important;color:#fff!important;background:#08a85d!important;font-size:28rpx;font-weight:700}.tools{display:flex;flex-direction:column;gap:14rpx;margin-top:16rpx}.tool{width:100%;margin:0!important;color:#087f50!important;background:#edf8f2!important;font-size:26rpx}.selected-count{display:block;margin-top:20rpx;color:#087f50;font-size:24rpx;font-weight:600}.media-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.media-item{width:190rpx;height:190rpx;position:relative;border-radius:14rpx;overflow:hidden;background:#edf4f0}.media-item image{width:100%;height:100%}.video-card,.document-card{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#087f50}.small{max-width:160rpx;margin-top:10rpx;padding:0 12rpx;font-size:21rpx;color:#76827c;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.media-state{position:absolute;left:0;right:0;bottom:0;padding:8rpx 10rpx;background:rgba(0,0,0,.52);color:#fff;font-size:20rpx;text-align:center}.media-state.failed{background:rgba(183,65,65,.8)}.remove,.retry{position:absolute;top:0;z-index:10;min-width:72rpx;min-height:56rpx;padding:0 12rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;background:rgba(0,0,0,.68);color:#fff;font-size:22rpx}.remove{right:0}.retry{left:0;background:#b74141}
