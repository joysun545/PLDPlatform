.uploader{margin-top:18rpx}.camera{width:100%;height:390rpx;border-radius:20rpx;overflow:hidden;background:#18221e}.shutter{width:106rpx;height:106rpx;margin:-62rpx auto 0;border:8rpx solid rgba(255,255,255,.94);border-radius:50%;background:rgba(8,135,85,.82);display:flex;align-items:center;justify-content:center;position:relative;z-index:2}.shutter.recording{background:#dd4d4d}.shutter-core{width:48rpx;height:48rpx;border-radius:50%;background:#fff}.recording .shutter-core{border-radius:10rpx}.capture-tip{display:block;text-align:center;margin:20rpx 0;color:#627069;font-size:24rpx}.tools{display:flex;flex-wrap:wrap;gap:14rpx}.tool{margin:0!important;color:#087f50!important;background:#edf8f2!important;font-size:24rpx}.media-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx}.media-item{width:190rpx;height:190rpx;position:relative;border-radius:14rpx;overflow:hidden;background:#edf4f0}.media-item image{width:100%;height:100%}.video-card,.document-card{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#087f50}.small{max-width:160rpx;margin-top:10rpx;padding:0 12rpx;font-size:21rpx;color:#76827c;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.media-state{position:absolute;left:0;right:0;bottom:0;padding:8rpx 10rpx;background:rgba(0,0,0,.52);color:#fff;font-size:20rpx;text-align:center}.media-state.failed{background:rgba(183,65,65,.8)}.remove,.retry{position:absolute;top:0;z-index:10;min-width:72rpx;min-height:56rpx;padding:0 12rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;background:rgba(0,0,0,.68);color:#fff;font-size:22rpx}.remove{right:0}.retry{left:0;background:#b74141}
