<view class="uploader">
  <view class="capture-panel">
    <text class="capture-title">添加现场图片或视频</text>
    <text class="capture-tip">拍摄会打开手机系统相机，可选择拍照或录像</text>
    <button class="camera-button" disabled="{{disabled || files.length >= maxCount}}" bindtap="chooseCameraMedia">打开相机拍照/录像</button>
  </view>

  <view class="tools">
    <button class="tool" disabled="{{disabled || files.length >= maxCount}}" bindtap="chooseLocalMedia">从手机相册选择图片/视频</button>
    <button wx:if="{{allowDocument}}" class="tool" disabled="{{disabled || files.length >= maxCount}}" bindtap="chooseDocument">从手机相册选择物流单据/凭证</button>
  </view>

  <text class="selected-count" wx:if="{{files.length}}">已选择 {{files.length}} 个附件，请确认缩略图后再提交</text>

  <view class="media-grid" wx:if="{{files.length}}">
    <view class="media-item" wx:for="{{files}}" wx:key="key" wx:for-item="file" wx:for-index="fileIndex">
      <image wx:if="{{file.media_type === 'IMAGE'}}" src="{{file.path}}" mode="aspectFill" data-index="{{fileIndex}}" bindtap="preview"></image>
      <view wx:elif="{{file.media_type === 'VIDEO'}}" class="video-card" data-index="{{fileIndex}}" bindtap="preview">
        <text>视频</text><text class="small">点击预览</text>
      </view>
      <view wx:else class="document-card"><text>单据</text><text class="small">{{file.name || '文件'}}</text></view>
      <view class="media-state {{file.status === 'FAILED' ? 'failed' : ''}}">{{file.status === 'SUCCESS' ? '已上传' : file.status === 'UPLOADING' ? '上传中' : file.status === 'FAILED' ? '上传失败' : '待上传'}}</view>
      <view class="remove" data-index="{{fileIndex}}" catchtap="onRemoveFile">删除</view>
      <view wx:if="{{file.status === 'FAILED'}}" class="retry" data-index="{{fileIndex}}" catchtap="retry">重试</view>
    </view>
  </view>
</view>
